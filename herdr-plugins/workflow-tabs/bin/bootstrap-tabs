#!/usr/bin/env python3
import json
import os
import subprocess
import sys


ROLES = ["editor", "agent", "process", "terminal"]


def herdr(*args):
    binary = os.environ.get("HERDR_BIN_PATH", "herdr")
    result = subprocess.run(
        [binary, *args],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if result.returncode != 0:
        raise SystemExit(result.stderr.strip() or result.stdout.strip())
    return json.loads(result.stdout)


def find_workspace_id(value):
    if isinstance(value, dict):
        if isinstance(value.get("workspace_id"), str):
            return value["workspace_id"]
        for child in value.values():
            found = find_workspace_id(child)
            if found:
                return found
    elif isinstance(value, list):
        for child in value:
            found = find_workspace_id(child)
            if found:
                return found
    return None


def context_workspace_id():
    raw = os.environ.get("HERDR_PLUGIN_CONTEXT_JSON")
    if raw:
        try:
            found = find_workspace_id(json.loads(raw))
            if found:
                return found
        except json.JSONDecodeError:
            pass
    return herdr("pane", "current")["result"]["pane"]["workspace_id"]


def main():
    workspace_id = context_workspace_id()
    tabs = herdr("tab", "list", "--workspace", workspace_id)["result"]["tabs"]
    labels = {(tab.get("label") or "").lower(): tab for tab in tabs}

    if "editor" not in labels:
        reusable = None
        if len(tabs) == 1 and (tabs[0].get("label") or "") in ("", "1"):
            reusable = tabs[0]
        if reusable:
            herdr("tab", "rename", reusable["tab_id"], "editor")
            labels["editor"] = reusable
        else:
            created = herdr("tab", "create", "--workspace", workspace_id, "--label", "editor", "--no-focus")
            labels["editor"] = created["result"]["tab"]

    for role in ROLES[1:]:
        if role not in labels:
            herdr("tab", "create", "--workspace", workspace_id, "--label", role, "--no-focus")

    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:
        print(f"workflow-tabs bootstrap: {exc}", file=sys.stderr)
        raise SystemExit(1)
