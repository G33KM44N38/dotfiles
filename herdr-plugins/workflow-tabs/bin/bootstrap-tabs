#!/usr/bin/env python3
import json
import os
import shutil
import subprocess
import sys
import time


ROLES = ["editor", "agent", "process", "terminal", "diff"]
LOCK_DIR = "/tmp/herdr-workflow-tabs"
RECENT_RUN_TTL_SECONDS = 10
DEFAULT_COMMANDS = {
    "editor": "nvim .",
    "agent": "pi",
    "process": "",
    "terminal": "",
    "diff": "hunk diff --watch",
}
SHELL_NAMES = {"bash", "fish", "sh", "zsh"}
AGENT_PROCESS_NAMES = {
    "claude",
    "codex",
    "devin",
    "hermes",
    "kimi",
    "kilo",
    "opencode",
    "pi",
    "qodercli",
}


def herdr(*args):
    binary = os.environ.get("HERDR_BIN_PATH", "herdr")
    result = subprocess.run(
        [binary, *args],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if result.returncode != 0:
        raise SystemExit(result.stderr.strip() or result.stdout.strip())
    if not result.stdout.strip():
        return {}
    return json.loads(result.stdout)


def command_for(role):
    key = f"HERDR_WORKFLOW_{role.upper()}_CMD"
    return os.environ.get(key, DEFAULT_COMMANDS[role]).strip()


def find_workspace_id(value):
    if isinstance(value, dict):
        if isinstance(value.get("workspace_id"), str):
            return value["workspace_id"]
        for child in value.values():
            found = find_workspace_id(child)
            if found:
                return found
    elif isinstance(value, list):
        for child in value:
            found = find_workspace_id(child)
            if found:
                return found
    return None


def context_workspace_id():
    raw = os.environ.get("HERDR_PLUGIN_CONTEXT_JSON")
    if raw:
        try:
            found = find_workspace_id(json.loads(raw))
            if found:
                return found
        except json.JSONDecodeError:
            pass
    return herdr("pane", "current")["result"]["pane"]["workspace_id"]


def workspace_cwd(workspace_id, panes):
    workspace = herdr("workspace", "get", workspace_id)["result"]["workspace"]
    worktree = workspace.get("worktree")
    if isinstance(worktree, dict) and worktree.get("checkout_path"):
        return worktree["checkout_path"]

    for pane in panes:
        if pane.get("workspace_id") == workspace_id and pane.get("cwd"):
            return pane["cwd"]

    return os.getcwd()


def labels_by_role(tabs):
    labels = {}
    for tab in sorted(tabs, key=lambda item: item.get("number", 0)):
        label = (tab.get("label") or "").lower()
        if label == "scratch":
            label = "diff"
        if label in ROLES and label not in labels:
            labels[label] = tab
    return labels


def ensure_tabs(workspace_id, cwd):
    tabs = herdr("tab", "list", "--workspace", workspace_id)["result"]["tabs"]
    labels = labels_by_role(tabs)

    for tab in tabs:
        if (tab.get("label") or "").lower() == "scratch" and "diff" not in labels:
            herdr("tab", "rename", tab["tab_id"], "diff")
            labels["diff"] = {**tab, "label": "diff"}

    if "editor" not in labels:
        reusable = None
        if len(tabs) == 1 and (tabs[0].get("label") or "") in ("", "1"):
            reusable = tabs[0]
        if reusable:
            herdr("tab", "rename", reusable["tab_id"], "editor")
            labels["editor"] = {**reusable, "label": "editor"}
        else:
            created = herdr(
                "tab",
                "create",
                "--workspace",
                workspace_id,
                "--cwd",
                cwd,
                "--label",
                "editor",
                "--no-focus",
            )
            labels["editor"] = created["result"]["tab"]

    for role in ROLES[1:]:
        if role not in labels:
            created = herdr(
                "tab",
                "create",
                "--workspace",
                workspace_id,
                "--cwd",
                cwd,
                "--label",
                role,
                "--no-focus",
            )
            labels[role] = created["result"]["tab"]

    return labels


def lock_workspace(workspace_id):
    os.makedirs(LOCK_DIR, exist_ok=True)
    lock_path = os.path.join(LOCK_DIR, f"{workspace_id}.lockdir")
    deadline = time.time() + 30

    while True:
        try:
            os.mkdir(lock_path)
            return lock_path
        except FileExistsError:
            try:
                age = time.time() - os.path.getmtime(lock_path)
                if age > 60:
                    shutil.rmtree(lock_path)
                    continue
            except FileNotFoundError:
                continue
            if time.time() >= deadline:
                raise TimeoutError(f"timed out waiting for workspace lock {workspace_id}")
            time.sleep(0.05)


def unlock_workspace(lock_path):
    shutil.rmtree(lock_path, ignore_errors=True)


def panes_by_tab(workspace_id):
    panes = herdr("pane", "list", "--workspace", workspace_id)["result"]["panes"]
    by_tab = {}
    for pane in panes:
        by_tab.setdefault(pane.get("tab_id"), []).append(pane)
    return by_tab


def foreground_processes(pane_id):
    info = herdr("pane", "process-info", "--pane", pane_id)["result"]["process_info"]
    return info.get("foreground_processes") or []


def process_name(process):
    name = process.get("name") or process.get("argv0") or ""
    return os.path.basename(name).lstrip("-").lower()


def is_shell_ready(pane, processes):
    if pane.get("agent"):
        return False
    if len(processes) != 1:
        return False
    return process_name(processes[0]) in SHELL_NAMES


def has_agent_process(panes):
    for pane in panes:
        if pane.get("agent"):
            return True
        for process in foreground_processes(pane["pane_id"]):
            if process_name(process) in AGENT_PROCESS_NAMES:
                return True
    return False


def recent_run_path(pane_id):
    safe_pane_id = "".join(ch if ch.isalnum() or ch in "._-" else "_" for ch in pane_id)
    return os.path.join(LOCK_DIR, f"recent-run-{safe_pane_id}.json")


def was_recently_run(pane_id, role, command):
    path = recent_run_path(pane_id)
    try:
        with open(path) as file:
            data = json.load(file)
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return False

    if data.get("role") != role or data.get("command") != command:
        return False
    return time.time() - float(data.get("time", 0)) < RECENT_RUN_TTL_SECONDS


def mark_recently_run(pane_id, role, command):
    os.makedirs(LOCK_DIR, exist_ok=True)
    path = recent_run_path(pane_id)
    with open(path, "w") as file:
        json.dump({"role": role, "command": command, "time": time.time()}, file)


def maybe_run_default(role, panes):
    command = command_for(role)
    if not command:
        return
    if not panes:
        return
    if role == "agent" and has_agent_process(panes):
        return
    if len(panes) != 1:
        return

    pane = panes[0]
    pane_id = pane["pane_id"]
    if was_recently_run(pane_id, role, command):
        return

    processes = foreground_processes(pane_id)
    if is_shell_ready(pane, processes):
        mark_recently_run(pane_id, role, command)
        herdr("pane", "run", pane_id, command)


def main():
    workspace_id = context_workspace_id()
    lock_path = lock_workspace(workspace_id)
    try:
        return bootstrap_workspace(workspace_id)
    finally:
        unlock_workspace(lock_path)


def bootstrap_workspace(workspace_id):
    initial_panes = herdr("pane", "list", "--workspace", workspace_id)["result"]["panes"]
    cwd = workspace_cwd(workspace_id, initial_panes)
    labels = ensure_tabs(workspace_id, cwd)
    panes = panes_by_tab(workspace_id)

    for role in ROLES:
        maybe_run_default(role, panes.get(labels[role]["tab_id"], []))

    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:
        print(f"workflow-tabs bootstrap: {exc}", file=sys.stderr)
        raise SystemExit(1)
