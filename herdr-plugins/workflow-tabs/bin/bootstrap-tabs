#!/usr/bin/env python3
import hashlib
import json
import os
import shlex
import shutil
import subprocess
import sys
import time


LOCK_DIR = "/tmp/herdr-workflow-tabs"
SHELL_NAMES = {"bash", "fish", "nu", "pwsh", "sh", "zsh"}


def herdr(*args):
    binary = os.environ.get("HERDR_BIN_PATH", "herdr")
    result = subprocess.run(
        [binary, *args],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if result.returncode != 0:
        raise SystemExit(result.stderr.strip() or result.stdout.strip())
    if not result.stdout.strip():
        return {}
    return json.loads(result.stdout)


def find_workspace_id(value):
    if isinstance(value, dict):
        if isinstance(value.get("workspace_id"), str):
            return value["workspace_id"]
        for child in value.values():
            found = find_workspace_id(child)
            if found:
                return found
    elif isinstance(value, list):
        for child in value:
            found = find_workspace_id(child)
            if found:
                return found
    return None


def context_workspace_id():
    raw = os.environ.get("HERDR_PLUGIN_CONTEXT_JSON")
    if raw:
        try:
            found = find_workspace_id(json.loads(raw))
            if found:
                return found
        except json.JSONDecodeError:
            pass
    return herdr("pane", "current")["result"]["pane"]["workspace_id"]


def workspace_cwd(workspace_id, panes):
    workspace = herdr("workspace", "get", workspace_id)["result"]["workspace"]
    worktree = workspace.get("worktree")
    if isinstance(worktree, dict) and worktree.get("checkout_path"):
        return worktree["checkout_path"]

    for pane in panes:
        if pane.get("workspace_id") == workspace_id and pane.get("cwd"):
            return pane["cwd"]

    return os.getcwd()


def ensure_terminal_tab(workspace_id, cwd):
    tabs = herdr("tab", "list", "--workspace", workspace_id)["result"]["tabs"]
    terminal = next(
        (tab for tab in tabs if (tab.get("label") or "").lower() == "terminal"),
        None,
    )
    if terminal:
        return terminal

    if len(tabs) == 1 and (tabs[0].get("label") or "") in ("", "1"):
        herdr("tab", "rename", tabs[0]["tab_id"], "terminal")
        return {**tabs[0], "label": "terminal"}

    created = herdr(
        "tab",
        "create",
        "--workspace",
        workspace_id,
        "--cwd",
        cwd,
        "--label",
        "terminal",
        "--no-focus",
    )
    return created["result"]["tab"]


def pane_for_tab(workspace_id, tab_id):
    panes = herdr("pane", "list", "--workspace", workspace_id)["result"]["panes"]
    return next((pane for pane in panes if pane.get("tab_id") == tab_id), None)


def process_name(process):
    name = process.get("name") or process.get("argv0") or ""
    return os.path.basename(name).lstrip("-").lower()


def pane_is_idle_shell(pane_id):
    info = herdr("pane", "process-info", "--pane", pane_id)["result"]["process_info"]
    processes = info.get("foreground_processes") or []
    return bool(processes) and all(
        process_name(process) in SHELL_NAMES for process in processes
    )


def is_git_worktree(path):
    result = subprocess.run(
        ["git", "-C", path, "rev-parse", "--is-bare-repository"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    return result.returncode == 0 and result.stdout.strip() == "false"


def bootstrap_marker(cwd):
    identity = f"{os.path.realpath(cwd)}:{os.stat(cwd).st_ino}"
    digest = hashlib.sha256(identity.encode()).hexdigest()[:20]
    state_dir = os.environ.get(
        "HERDR_PLUGIN_STATE_DIR", os.path.join(LOCK_DIR, "state")
    )
    return os.path.join(state_dir, f"worktree-{digest}.done")


def maybe_bootstrap_worktree(workspace_id, terminal_tab, cwd):
    if not is_git_worktree(cwd):
        return

    marker = bootstrap_marker(cwd)
    if os.path.exists(marker):
        return

    pane = pane_for_tab(workspace_id, terminal_tab["tab_id"])
    if pane is None or not pane_is_idle_shell(pane["pane_id"]):
        return

    bootstrap = os.path.expanduser("~/.dotfiles/bin/bootstrap_local_worktree.sh")
    command = " && ".join(
        (
            f"{shlex.quote(bootstrap)} {shlex.quote(cwd)}",
            f"mkdir -p {shlex.quote(os.path.dirname(marker))}",
            f"touch {shlex.quote(marker)}",
        )
    )
    herdr("pane", "run", pane["pane_id"], command)


def lock_workspace(workspace_id):
    os.makedirs(LOCK_DIR, exist_ok=True)
    lock_path = os.path.join(LOCK_DIR, f"{workspace_id}.lockdir")
    deadline = time.time() + 30

    while True:
        try:
            os.mkdir(lock_path)
            return lock_path
        except FileExistsError:
            try:
                age = time.time() - os.path.getmtime(lock_path)
                if age > 60:
                    shutil.rmtree(lock_path)
                    continue
            except FileNotFoundError:
                continue
            if time.time() >= deadline:
                raise TimeoutError(f"timed out waiting for workspace lock {workspace_id}")
            time.sleep(0.05)


def unlock_workspace(lock_path):
    shutil.rmtree(lock_path, ignore_errors=True)


def ensure_activity_monitor():
    monitor = os.path.join(os.path.dirname(__file__), "activity-monitor")
    if not os.path.isfile(monitor):
        return
    subprocess.Popen(
        [monitor],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
        close_fds=True,
        env=os.environ.copy(),
    )


def main():
    ensure_activity_monitor()
    workspace_id = context_workspace_id()
    lock_path = lock_workspace(workspace_id)
    try:
        return bootstrap_workspace(workspace_id)
    finally:
        unlock_workspace(lock_path)


def bootstrap_workspace(workspace_id):
    initial_panes = herdr("pane", "list", "--workspace", workspace_id)["result"]["panes"]
    cwd = workspace_cwd(workspace_id, initial_panes)
    terminal_tab = ensure_terminal_tab(workspace_id, cwd)
    maybe_bootstrap_worktree(workspace_id, terminal_tab, cwd)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:
        print(f"workflow-tabs bootstrap: {exc}", file=sys.stderr)
        raise SystemExit(1)
