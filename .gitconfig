[includeIf "gitdir:~/coding/work/division-v/*"]
  path = ./git_configuration/.gitconfig-division
[user]
	email = kylianmayanga@gmail.com
	name = kylian
[pull]
	rebase = true
[rebase]
	autosquash = true
[rerere]
	enabled = true
	autoupdate = true
[push]
	autoSetupRemote = true
[branch]
	autoSetupMerge = true
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
