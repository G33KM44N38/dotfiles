<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.kylian.worktree-chore-babacoiffure</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{ ansible_facts.env.HOME }}/.dotfiles/bin/worktree-chore</string>
    <string>--automation</string>
    <string>--fetch</string>
  </array>
  <key>WorkingDirectory</key>
  <string>{{ ansible_facts.env.HOME }}/coding/work/babacoiffure_monorepo.git</string>
  <key>StartInterval</key>
  <integer>21600</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>{{ ansible_facts.env.HOME }}/Library/Logs/worktree-chore-babacoiffure.log</string>
  <key>StandardErrorPath</key>
  <string>{{ ansible_facts.env.HOME }}/Library/Logs/worktree-chore-babacoiffure.log</string>
</dict>
</plist>
