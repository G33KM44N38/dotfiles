#!/usr/bin/env python3
import importlib.util
from importlib.machinery import SourceFileLoader
from pathlib import Path


DOTFILES = Path("/Users/boss/.dotfiles")


def main():
    path = DOTFILES / "bin/herdr-focus-agent-pane"
    loader = SourceFileLoader("herdr_focus_agent_pane", str(path))
    spec = importlib.util.spec_from_loader("herdr_focus_agent_pane", loader)
    assert spec and spec.loader
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)

    calls = []

    def fake_herdr(*arguments):
        calls.append(arguments)
        if arguments == ("pane", "layout"):
            return {
                "result": {
                    "layout": {
                        "tab_id": "proof:t1",
                        "panes": [
                            {"pane_id": "proof:right", "rect": {"x": 80, "y": 0}},
                            {"pane_id": "proof:left", "rect": {"x": 0, "y": 0}},
                            {"pane_id": "proof:middle", "rect": {"x": 40, "y": 0}},
                        ],
                    }
                }
            }
        if arguments == ("agent", "list"):
            return {
                "result": {
                    "agents": [
                        {"pane_id": "proof:left", "tab_id": "proof:t1"},
                        {"pane_id": "proof:middle", "tab_id": "proof:t1"},
                        {"pane_id": "proof:right", "tab_id": "proof:t1"},
                        {"pane_id": "other:pane", "tab_id": "other:tab"},
                    ]
                }
            }
        return {}

    module.herdr = fake_herdr
    assert module.focus_index(2)
    assert calls[-1] == ("agent", "focus", "proof:right")
    assert not module.focus_index(4)
    assert ("agent", "list") in calls
    print("herdr-focus-agent-pane-ok")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
