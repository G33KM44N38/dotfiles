#!/usr/bin/env python3
"""Focused regressions for custom interactive Codex launch identity."""

from __future__ import annotations

import importlib.util
from importlib.machinery import SourceFileLoader
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import time


DOTFILES = Path(__file__).resolve().parent.parent


def write_executable(path: Path, content: str) -> None:
    path.write_text(content)
    path.chmod(0o755)


def test_machine_launcher_starts_mac_codex() -> None:
    with tempfile.TemporaryDirectory(prefix="herdr-launchers-") as directory:
        root = Path(directory)
        bin_dir = root / "bin"
        bin_dir.mkdir()
        log = root / "herdr.log"
        write_executable(
            bin_dir / "herdr",
            """#!/bin/sh
printf '%s\n' "$*" >>"$HERDR_TEST_LOG"
case "$*" in
  'worktree create --cwd @DOTFILES@ --branch thread/explain-failure --label Explain the failure --focus --json --base main')
    printf '%s\n' '{"result":{"workspace":{"workspace_id":"proof-thread"},"worktree":{"path":"@DOTFILES@"}}}'
    ;;
  'agent list')
    if [ -e "$HERDR_AGENT_STARTED" ]; then
      printf '%s\n' '{"result":{"agents":[{"name":"dotfiles-codex"},{"name":"codex","agent":"codex","pane_id":"proof-thread:p2","tab_id":"proof-thread:t1"}]}}'
    else
      printf '%s\n' '{"result":{"agents":[{"name":"dotfiles-codex"}]}}'
    fi
    ;;
  'tab list --workspace proof-thread')
    printf '%s\n' '{"result":{"tabs":[{"tab_id":"proof-thread:t1","label":"agent"}]}}'
    ;;
  'pane list --workspace proof-thread')
    printf '%s\n' '{"result":{"panes":[{"pane_id":"proof-thread:p1","tab_id":"proof-thread:t1"}]}}'
    ;;
  'pane split proof-thread:p1 --direction right --cwd @DOTFILES@ --no-focus')
    printf '%s\n' '{"result":{"pane":{"pane_id":"proof-thread:p2"}}}'
    ;;
  'pane process-info --pane proof-thread:p2')
    printf '%s\n' '{"result":{"process_info":{"foreground_processes":[{"name":"zsh"}]}}}'
    ;;
  'pane run proof-thread:p2 @DOTFILES@/bin/herdr-run-codex-agent --interactive --close-tab-on-exit --dangerously-bypass-hook-trust')
    : >"$HERDR_AGENT_STARTED"
    ;;
esac
""".replace("@DOTFILES@", str(DOTFILES)),
        )
        title_log = root / "title.log"
        write_executable(
            bin_dir / "title-generator",
            """#!/bin/sh
printf '%s\n' "$*" >"$HERDR_TITLE_LOG"
""",
        )
        env = {
            **os.environ,
            "PATH": f"{bin_dir}:/usr/bin:/bin",
            "HERDR_BIN_PATH": str(bin_dir / "herdr"),
            "HERDR_ACTIVE_WORKSPACE_ID": "proof-launch",
            "HERDR_ACTIVE_PANE_CWD": str(DOTFILES),
            "HERDR_TEST_LOG": str(log),
            "HERDR_AGENT_STARTED": str(root / "agent-started"),
            "HERDR_TITLE_GENERATOR": str(bin_dir / "title-generator"),
            "HERDR_TITLE_LOG": str(title_log),
            "DOTFILES_ROOT": str(DOTFILES),
        }
        result = subprocess.run(
            [
                str(DOTFILES / "bin/herdr-start-codex"),
                "mac",
                "--prompt",
                "Explain the failure",
                "--new-worktree",
                "thread/explain-failure",
            ],
            text=True,
            env=env,
            capture_output=True,
        )
        calls = log.read_text().splitlines()
        assert result.returncode == 0, {
            "calls": calls,
            "stdout": result.stdout,
            "stderr": result.stderr,
        }
        start_call = (
            "pane run proof-thread:p2 "
            f"{DOTFILES}/bin/herdr-run-codex-agent "
            "--interactive --close-tab-on-exit --dangerously-bypass-hook-trust"
        )
        assert calls.count(start_call) == 1, {
            "calls": calls,
            "stdout": result.stdout,
            "stderr": result.stderr,
        }
        assert calls.index("tab focus proof-thread:t1") > calls.index(start_call)
        assert result.stderr == ""
        assert (
            f"worktree create --cwd {DOTFILES} "
            "--branch thread/explain-failure --label Explain the failure "
            "--focus --json --base main"
        ) in calls
        metadata = next(call for call in calls if call.startswith("pane report-metadata "))
        assert metadata.startswith(
            "pane report-metadata proof-thread:p2 --source boss:codex-launch-title "
            "--agent codex --title codex-agent --display-agent Mac · Codex --seq "
        )
        assert "agent rename proof-thread:p2 codex-agent" in calls
        assert "agent focus proof-thread:p2" in calls
        assert "agent wait proof-thread:p2 --until idle --timeout 30000" in calls
        assert "agent prompt proof-thread:p2 Explain the failure" in calls
        assert not any(call.startswith("agent start ") for call in calls)
        deadline = time.monotonic() + 2
        while not title_log.exists() and time.monotonic() < deadline:
            time.sleep(0.01)
        assert title_log.exists(), "title generator was not started"
        title_call = title_log.read_text().strip()
        assert "--prompt Explain the failure" in title_call
        assert "--workspace proof-thread" in title_call
        assert "--machine Mac" in title_call


def test_remote_wrapper_attaches_persistent_herdr_agent() -> None:
    with tempfile.TemporaryDirectory(prefix="herdr-remote-direct-") as directory:
        root = Path(directory)
        bin_dir = root / "bin"
        bin_dir.mkdir()
        herdr_log = root / "herdr.log"
        ssh_log = root / "ssh.log"
        write_executable(
            bin_dir / "herdr",
            """#!/bin/sh
printf '%s\n' "$*" >>"$HERDR_TEST_LOG"
""",
        )
        write_executable(
            bin_dir / "ssh",
            """#!/bin/sh
printf '%s\n' "$*" >>"$SSH_TEST_LOG"
case "$*" in
  *'--remote-start'*)
    printf '%s\n' '{"thread_key":"proof-thread","session":"default","workspace_id":"remote:w1","pane_id":"remote:p2","agent_name":"remote-codex","agent_session":"session-1"}'
    ;;
  *'agent get remote:p2'*)
    exit 1
    ;;
esac
""",
        )
        env = {
            **os.environ,
            "PATH": f"{bin_dir}:/usr/bin:/bin",
            "HERDR_BIN_PATH": str(bin_dir / "herdr"),
            "HERDR_ENV": "1",
            "HERDR_WORKSPACE_ID": "proof-thread",
            "HERDR_PANE_ID": "proof:p2",
            "HERDR_TEST_LOG": str(herdr_log),
            "SSH_TEST_LOG": str(ssh_log),
            "XDG_STATE_HOME": str(root / "state"),
        }

        subprocess.run(
            [
                str(DOTFILES / "bin/herdr-run-remote-codex-agent"),
                "--target",
                "ubuntu.test",
                "--remote-path",
                "/remote/project path",
                "--prompt",
                "Fix login now",
                "--title",
                "Fix login",
            ],
            text=True,
            env=env,
            check=True,
            capture_output=True,
        )

        ssh_calls = ssh_log.read_text().splitlines()
        provision = next(call for call in ssh_calls if "--remote-start" in call)
        attach = next(call for call in ssh_calls if "agent attach" in call)
        assert "--thread-key proof-thread" in provision
        assert "--prompt Fix\\ login\\ now" in provision
        assert "--title Fix\\ login" in provision
        assert "/usr/local/bin/herdr agent attach remote:p2 --takeover" in attach
        assert not any("exec /usr/local/bin/codex" in call for call in ssh_calls)
        context = json.loads((root / "state/herdr/remote-workspaces/proof-thread.json").read_text())
        assert context["remote_pane_id"] == "remote:p2"
        assert context["remote_workspace_id"] == "remote:w1"
        calls = herdr_log.read_text().splitlines()
        assert any("--display-agent Ubuntu · Codex" in call for call in calls)
        assert any("--title Fix login" in call for call in calls)


def test_remote_tool_wrapper_targets_same_worktree() -> None:
    with tempfile.TemporaryDirectory(prefix="herdr-remote-tool-") as directory:
        root = Path(directory)
        bin_dir = root / "bin"
        bin_dir.mkdir()
        herdr_log = root / "herdr.log"
        ssh_log = root / "ssh.log"
        write_executable(
            bin_dir / "herdr",
            """#!/bin/sh
printf '%s\n' "$*" >>"$HERDR_TEST_LOG"
""",
        )
        write_executable(
            bin_dir / "ssh",
            """#!/bin/sh
printf '%s\n' "$*" >>"$SSH_TEST_LOG"
""",
        )
        env = {
            **os.environ,
            "PATH": f"{bin_dir}:/usr/bin:/bin",
            "HERDR_BIN_PATH": str(bin_dir / "herdr"),
            "HERDR_ENV": "1",
            "HERDR_PANE_ID": "proof:p3",
            "HERDR_TEST_LOG": str(herdr_log),
            "SSH_TEST_LOG": str(ssh_log),
        }

        subprocess.run(
            [
                str(DOTFILES / "bin/herdr-run-remote-pane"),
                "--target",
                "ubuntu.test",
                "--remote-path",
                "/remote/project path",
                "--kind",
                "editor",
            ],
            env=env,
            text=True,
            check=True,
            capture_output=True,
        )

        ssh_call = ssh_log.read_text().strip()
        assert "ubuntu.test" in ssh_call
        assert "cd -- /remote/project\\ path && exec nvim ." in ssh_call
        calls = herdr_log.read_text().splitlines()
        assert "pane rename proof:p3 Ubuntu · Editor" in calls
        assert any("--token machine=Ubuntu" in call for call in calls)


def test_remote_codex_monitor_reads_visible_status() -> None:
    sys.dont_write_bytecode = True
    path = DOTFILES / "bin/herdr-monitor-remote-codex"
    loader = SourceFileLoader("herdr_monitor_remote_codex", str(path))
    spec = importlib.util.spec_from_loader("herdr_monitor_remote_codex", loader)
    assert spec and spec.loader
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)

    assert module.screen_state("• Working (12s • esc to interrupt)\n› Ask Codex to do anything") == "working"
    assert module.screen_state("• Task finished\n› Ask Codex to do anything\nweekly 70% left") == "idle"
    assert module.screen_state("Would you like to run the following command?\nPress Enter to confirm") == "blocked"
    assert module.screen_state("connecting to Ubuntu") is None


def test_ai_thread_title_is_cleaned_for_herdr() -> None:
    sys.dont_write_bytecode = True
    path = DOTFILES / "bin/herdr-generate-thread-title"
    loader = SourceFileLoader("herdr_generate_thread_title", str(path))
    spec = importlib.util.spec_from_loader("herdr_generate_thread_title", loader)
    assert spec and spec.loader
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)

    assert module.clean_title('"Fix remote thread status."') == "Fix remote thread status"
    assert module.clean_title("```text\nImprove worktree navigation\n```") == "Improve worktree navigation"
    assert module.clean_title("#") is None


def test_saved_thread_resumes_in_its_plain_path() -> None:
    with tempfile.TemporaryDirectory(prefix="herdr-resume-") as directory:
        root = Path(directory)
        checkout = root / "saved-path"
        checkout.mkdir()
        bin_dir = root / "bin"
        bin_dir.mkdir()
        log = root / "herdr.log"
        started = root / "agent-started"
        log = root / "herdr.log"
        write_executable(
            bin_dir / "herdr",
            f"""#!/bin/sh
printf '%s\n' "$*" >>"$HERDR_TEST_LOG"
case "$*" in
  'workspace list')
    printf '%s\n' '{{"result":{{"workspaces":[{{"workspace_id":"saved","repository":{{"checkout_path":"{checkout}"}}}}]}}}}'
    ;;
  'agent list')
    if [ -e "$HERDR_AGENT_STARTED" ]; then
      printf '%s\n' '{{"result":{{"agents":[{{"name":"codex","agent":"codex","pane_id":"saved:p2","tab_id":"saved:t1","agent_session":{{"value":"session-123"}}}}]}}}}'
    else
      printf '%s\n' '{{"result":{{"agents":[]}}}}'
    fi
    ;;
  'tab list --workspace saved')
    printf '%s\n' '{{"result":{{"tabs":[{{"tab_id":"saved:t1","label":"agent"}}]}}}}'
    ;;
  'pane list --workspace saved')
    printf '%s\n' '{{"result":{{"panes":[{{"pane_id":"saved:p1","tab_id":"saved:t1"}}]}}}}'
    ;;
  'pane split saved:p1 --direction right --cwd '*' --no-focus')
    printf '%s\n' '{{"result":{{"pane":{{"pane_id":"saved:p2"}}}}}}'
    ;;
  'pane process-info --pane saved:p2')
    printf '%s\n' '{{"result":{{"process_info":{{"foreground_processes":[{{"name":"zsh"}}]}}}}}}'
    ;;
  'pane run saved:p2 '*'-C '*'resume --all session-123'*)
    : >"$HERDR_AGENT_STARTED"
    ;;
esac
""",
        )
        env = {
            **os.environ,
            "PATH": f"{bin_dir}:/usr/bin:/bin",
            "HERDR_BIN_PATH": str(bin_dir / "herdr"),
            "HERDR_TEST_LOG": str(log),
            "HERDR_AGENT_STARTED": str(started),
        }

        result = subprocess.run(
            [
                str(DOTFILES / "bin/herdr-start-codex"),
                "mac",
                "--project-path",
                str(checkout),
                "--resume",
                "session-123",
            ],
            text=True,
            env=env,
            capture_output=True,
        )

        calls = log.read_text().splitlines()
        assert result.returncode == 0, {
            "calls": calls,
            "stdout": result.stdout,
            "stderr": result.stderr,
        }
        run_call = next(
            (call for call in calls if call.startswith("pane run saved:p2 ")),
            None,
        )
        assert run_call is not None, calls
        assert (
            "herdr-run-codex-agent --interactive --close-tab-on-exit "
            "--dangerously-bypass-hook-trust -C"
        ) in run_call
        assert "resume --all session-123" in run_call
        assert "workspace create" not in "\n".join(calls)
        assert "agent focus saved:p2" in calls


def test_saved_thread_from_bare_repo_uses_default_checkout() -> None:
    with tempfile.TemporaryDirectory(prefix="herdr-resume-bare-") as directory:
        root = Path(directory)
        seed = root / "seed"
        repository = root / "project.git"
        checkout = repository / "main"
        bin_dir = root / "bin"
        bin_dir.mkdir()
        log = root / "herdr.log"
        started = root / "agent-started"

        subprocess.run(["git", "init", "-q", "-b", "main", seed], check=True)
        subprocess.run(["git", "-C", seed, "config", "user.name", "Test"], check=True)
        subprocess.run(["git", "-C", seed, "config", "user.email", "test@example.com"], check=True)
        (seed / "README.md").write_text("test\n")
        subprocess.run(["git", "-C", seed, "add", "README.md"], check=True)
        subprocess.run(["git", "-C", seed, "commit", "-q", "-m", "initial"], check=True)
        subprocess.run(["git", "clone", "-q", "--bare", seed, repository], check=True)
        subprocess.run(["git", "--git-dir", repository, "worktree", "add", "-q", checkout, "main"], check=True)

        write_executable(
            bin_dir / "herdr",
            f"""#!/bin/sh
printf '%s\n' "$*" >>"$HERDR_TEST_LOG"
case "$*" in
  'workspace list')
    printf '%s\n' '{{"result":{{"workspaces":[{{"workspace_id":"saved","repository":{{"checkout_path":"{checkout}"}}}}]}}}}'
    ;;
  'agent list')
    if [ -e "$HERDR_AGENT_STARTED" ]; then
      printf '%s\n' '{{"result":{{"agents":[{{"name":"codex","agent":"codex","pane_id":"saved:p2","tab_id":"saved:t1"}}]}}}}'
    else
      printf '%s\n' '{{"result":{{"agents":[]}}}}'
    fi
    ;;
  'tab list --workspace saved')
    printf '%s\n' '{{"result":{{"tabs":[{{"tab_id":"saved:t1","label":"agent"}}]}}}}'
    ;;
  'pane list --workspace saved')
    printf '%s\n' '{{"result":{{"panes":[{{"pane_id":"saved:p1","tab_id":"saved:t1"}}]}}}}'
    ;;
  'pane split saved:p1 --direction right --cwd '*' --no-focus')
    printf '%s\n' '{{"result":{{"pane":{{"pane_id":"saved:p2"}}}}}}'
    ;;
  'pane process-info --pane saved:p2')
    printf '%s\n' '{{"result":{{"process_info":{{"foreground_processes":[{{"name":"zsh"}}]}}}}}}'
    ;;
  'pane run saved:p2 '*'-C '*'project.git/main resume --all session-123'*)
    : >"$HERDR_AGENT_STARTED"
    ;;
  'agent read saved:p2 --source visible --lines 30 --format text')
    printf '%s\n' 'Earlier messages are available' '› Ask Codex to do anything'
    ;;
esac
""",
        )
        env = {
            **os.environ,
            "PATH": f"{bin_dir}:/usr/bin:/bin",
            "HERDR_BIN_PATH": str(bin_dir / "herdr"),
            "HERDR_TEST_LOG": str(log),
            "HERDR_AGENT_STARTED": str(started),
        }

        result = subprocess.run(
            [
                str(DOTFILES / "bin/herdr-start-codex"),
                "mac",
                "--project-path",
                str(repository),
                "--resume",
                "session-123",
            ],
            text=True,
            env=env,
            capture_output=True,
        )

        calls = log.read_text().splitlines()
        assert result.returncode == 0, {
            "calls": calls,
            "stdout": result.stdout,
            "stderr": result.stderr,
        }
        run_call = next(call for call in calls if call.startswith("pane run saved:p2 "))
        assert f"-C {checkout.resolve()} resume --all session-123" in run_call
        assert f"-C {repository.resolve()} resume" not in run_call
        assert "agent read saved:p2 --source visible --lines 30 --format text" in calls
        assert "workspace create" not in "\n".join(calls)


def test_default_branch_origin_sync_refuses_dirty_checkout() -> None:
    with tempfile.TemporaryDirectory(prefix="herdr-default-sync-") as directory:
        root = Path(directory)
        checkout = root / "project"
        origin = root / "origin.git"
        bin_dir = root / "bin"
        bin_dir.mkdir()
        subprocess.run(["git", "init", "-q", "--bare", origin], check=True)
        subprocess.run(["git", "init", "-q", "-b", "trunk", checkout], check=True)
        subprocess.run(["git", "-C", checkout, "config", "user.name", "Test"], check=True)
        subprocess.run(
            ["git", "-C", checkout, "config", "user.email", "test@example.com"],
            check=True,
        )
        (checkout / "README.md").write_text("clean\n")
        subprocess.run(["git", "-C", checkout, "add", "README.md"], check=True)
        subprocess.run(["git", "-C", checkout, "commit", "-q", "-m", "initial"], check=True)
        subprocess.run(["git", "-C", checkout, "remote", "add", "origin", str(origin)], check=True)
        subprocess.run(["git", "-C", checkout, "push", "-q", "-u", "origin", "trunk"], check=True)
        (checkout / "README.md").write_text("dirty\n")
        write_executable(bin_dir / "herdr", "#!/bin/sh\nexit 1\n")

        env = {
            **os.environ,
            "PATH": f"{bin_dir}:/usr/bin:/bin",
            "HERDR_BIN_PATH": str(bin_dir / "herdr"),
            "HERDR_ACTIVE_WORKSPACE_ID": "current",
            "HERDR_ACTIVE_PANE_CWD": str(checkout),
        }
        result = subprocess.run(
            [
                str(DOTFILES / "bin/herdr-start-codex"),
                "mac",
                "--git-space",
                "default",
                "--source",
                "origin",
                "--default-branch",
                "trunk",
            ],
            env=env,
            text=True,
            capture_output=True,
        )

        assert result.returncode != 0
        assert "default branch checkout has local changes" in result.stderr
        assert (checkout / "README.md").read_text() == "dirty\n"


def test_default_branch_origin_sync_fast_forwards_clean_checkout() -> None:
    with tempfile.TemporaryDirectory(prefix="herdr-default-ff-") as directory:
        root = Path(directory)
        checkout = root / "project"
        updater = root / "updater"
        origin = root / "origin.git"
        bin_dir = root / "bin"
        bin_dir.mkdir()
        started = root / "agent-started"
        log = root / "herdr.log"
        subprocess.run(["git", "init", "-q", "--bare", origin], check=True)
        subprocess.run(["git", "init", "-q", "-b", "trunk", checkout], check=True)
        for repository in (checkout,):
            subprocess.run(["git", "-C", repository, "config", "user.name", "Test"], check=True)
            subprocess.run(
                ["git", "-C", repository, "config", "user.email", "test@example.com"],
                check=True,
            )
        (checkout / "README.md").write_text("old\n")
        subprocess.run(["git", "-C", checkout, "add", "README.md"], check=True)
        subprocess.run(["git", "-C", checkout, "commit", "-q", "-m", "initial"], check=True)
        subprocess.run(["git", "-C", checkout, "remote", "add", "origin", str(origin)], check=True)
        subprocess.run(["git", "-C", checkout, "push", "-q", "-u", "origin", "trunk"], check=True)
        subprocess.run(["git", "--git-dir", origin, "symbolic-ref", "HEAD", "refs/heads/trunk"], check=True)
        subprocess.run(["git", "clone", "-q", origin, updater], check=True)
        subprocess.run(["git", "-C", updater, "config", "user.name", "Test"], check=True)
        subprocess.run(["git", "-C", updater, "config", "user.email", "test@example.com"], check=True)
        (updater / "README.md").write_text("new\n")
        subprocess.run(["git", "-C", updater, "commit", "-q", "-am", "update"], check=True)
        subprocess.run(["git", "-C", updater, "push", "-q", "origin", "trunk"], check=True)

        write_executable(
            bin_dir / "herdr",
            f"""#!/bin/sh
printf '%s\n' "$*" >>"$HERDR_TEST_LOG"
case "$*" in
  'workspace list')
    printf '%s\n' '{{"result":{{"workspaces":[{{"workspace_id":"current","repository":{{"checkout_path":"{checkout}"}}}}]}}}}'
    ;;
  'agent list')
    if [ -e "$HERDR_AGENT_STARTED" ]; then
      printf '%s\n' '{{"result":{{"agents":[{{"name":"codex","agent":"codex","pane_id":"current:p2","tab_id":"current:t1"}}]}}}}'
    else
      printf '%s\n' '{{"result":{{"agents":[]}}}}'
    fi
    ;;
  'tab list --workspace current')
    printf '%s\n' '{{"result":{{"tabs":[{{"tab_id":"current:t1","label":"agent"}}]}}}}'
    ;;
  'pane list --workspace current')
    printf '%s\n' '{{"result":{{"panes":[{{"pane_id":"current:p1","tab_id":"current:t1"}}]}}}}'
    ;;
  'pane split current:p1 --direction right --cwd '*' --no-focus')
    printf '%s\n' '{{"result":{{"pane":{{"pane_id":"current:p2"}}}}}}'
    ;;
  'pane process-info --pane current:p2')
    printf '%s\n' '{{"result":{{"process_info":{{"foreground_processes":[{{"name":"zsh"}}]}}}}}}'
    ;;
  'pane run current:p2 '*)
    : >"$HERDR_AGENT_STARTED"
    ;;
esac
""",
        )
        env = {
            **os.environ,
            "PATH": f"{bin_dir}:/usr/bin:/bin",
            "HERDR_BIN_PATH": str(bin_dir / "herdr"),
            "HERDR_ACTIVE_WORKSPACE_ID": "current",
            "HERDR_ACTIVE_PANE_CWD": str(checkout),
            "HERDR_AGENT_STARTED": str(started),
            "HERDR_TEST_LOG": str(log),
        }
        result = subprocess.run(
            [
                str(DOTFILES / "bin/herdr-start-codex"),
                "mac",
                "--git-space",
                "default",
                "--source",
                "origin",
                "--default-branch",
                "trunk",
            ],
            env=env,
            text=True,
            capture_output=True,
        )

        assert result.returncode == 0, {
            "calls": log.read_text().splitlines(),
            "stdout": result.stdout,
            "stderr": result.stderr,
        }
        assert (checkout / "README.md").read_text() == "new\n"
        local_head = subprocess.run(
            ["git", "-C", checkout, "rev-parse", "HEAD"],
            text=True,
            check=True,
            capture_output=True,
        ).stdout.strip()
        remote_head = subprocess.run(
            ["git", "--git-dir", origin, "rev-parse", "trunk"],
            text=True,
            check=True,
            capture_output=True,
        ).stdout.strip()
        assert local_head == remote_head


def test_remote_project_resolution_requires_matching_branch() -> None:
    with tempfile.TemporaryDirectory(prefix="herdr-remote-project-") as directory:
        root = Path(directory)
        checkout = root / "code" / "project"
        checkout.mkdir(parents=True)
        subprocess.run(["git", "init", "-q", "-b", "main", checkout], check=True)
        subprocess.run(
            [
                "git",
                "-C",
                checkout,
                "remote",
                "add",
                "origin",
                "git@github.com:owner/project.git",
            ],
            check=True,
        )
        env = {**os.environ, "HERDR_REMOTE_CODE_ROOT": str(root / "code")}
        wrapper = DOTFILES / "bin/herdr-run-remote-codex-agent"

        resolved = subprocess.run(
            [
                wrapper,
                "--remote-resolve",
                "--repo-url",
                "https://github.com/owner/project.git",
                "--branch",
                "main",
                "--project-name",
                "project",
            ],
            env=env,
            text=True,
            check=True,
            capture_output=True,
        )
        assert resolved.stdout.strip() == str(checkout)

        fork_resolved = subprocess.run(
            [
                wrapper,
                "--remote-resolve",
                "--repo-url",
                "git@github.com:another-owner/project.git",
                "--branch",
                "main",
                "--project-name",
                "project",
            ],
            env=env,
            text=True,
            check=True,
            capture_output=True,
        )
        assert fork_resolved.stdout.strip() == str(checkout)

        default_resolved = subprocess.run(
            [
                wrapper,
                "--remote-default",
                "--repo-url",
                "https://github.com/owner/project.git",
                "--branch",
                "main",
                "--source",
                "local",
                "--project-name",
                "project",
            ],
            env=env,
            text=True,
            check=True,
            capture_output=True,
        )
        assert default_resolved.stdout.strip() == str(checkout)

        (checkout / "dirty.txt").write_text("keep\n")
        dirty_default = subprocess.run(
            [
                wrapper,
                "--remote-default",
                "--repo-url",
                "https://github.com/owner/project.git",
                "--branch",
                "main",
                "--source",
                "origin",
                "--project-name",
                "project",
            ],
            env=env,
            text=True,
            capture_output=True,
        )
        assert dirty_default.returncode != 0
        assert "default branch checkout has local changes" in dirty_default.stderr
        assert (checkout / "dirty.txt").read_text() == "keep\n"

        wrong_branch = subprocess.run(
            [
                wrapper,
                "--remote-resolve",
                "--repo-url",
                "https://github.com/owner/project.git",
                "--branch",
                "feature",
                "--project-name",
                "project",
            ],
            env=env,
            text=True,
            capture_output=True,
        )
        assert wrong_branch.returncode == 3
        assert "on branch main, not feature" in wrong_branch.stderr


def test_remote_worktree_is_created_and_reused() -> None:
    with tempfile.TemporaryDirectory(prefix="herdr-remote-worktree-") as directory:
        root = Path(directory)
        checkout = root / "code" / "project"
        checkout.mkdir(parents=True)
        subprocess.run(["git", "init", "-q", "-b", "main", checkout], check=True)
        subprocess.run(["git", "-C", checkout, "config", "user.name", "Test"], check=True)
        subprocess.run(
            ["git", "-C", checkout, "config", "user.email", "test@example.com"],
            check=True,
        )
        (checkout / "README.md").write_text("test\n")
        subprocess.run(["git", "-C", checkout, "add", "README.md"], check=True)
        subprocess.run(["git", "-C", checkout, "commit", "-q", "-m", "test"], check=True)
        subprocess.run(
            [
                "git",
                "-C",
                checkout,
                "remote",
                "add",
                "origin",
                "git@github.com:owner/project.git",
            ],
            check=True,
        )

        env = {
            **os.environ,
            "HERDR_REMOTE_CODE_ROOT": str(root / "code"),
            "HERDR_REMOTE_WORKTREE_ROOT": str(root / "code" / "work"),
        }
        wrapper = DOTFILES / "bin/herdr-run-remote-codex-agent"
        command = [
            wrapper,
            "--remote-worktree",
            "--repo-url",
            "https://github.com/owner/project.git",
            "--branch",
            "thread/fix-checkout",
            "--base",
            "main",
            "--project-name",
            "project",
        ]
        first = subprocess.run(command, env=env, text=True, check=True, capture_output=True)
        second = subprocess.run(command, env=env, text=True, check=True, capture_output=True)

        worktree = Path(first.stdout.strip())
        assert second.stdout.strip() == str(worktree), {
            "first": first.stdout,
            "second": second.stdout,
            "second_stderr": second.stderr,
        }
        assert worktree == (
            root / "code" / "work" / "project.git" / "thread-fix-checkout"
        ).resolve()
        assert (
            subprocess.run(
                ["git", "-C", worktree, "branch", "--show-current"],
                text=True,
                check=True,
                capture_output=True,
            ).stdout.strip()
            == "thread/fix-checkout"
        )


def test_remote_worktree_origin_uses_latest_default_branch() -> None:
    with tempfile.TemporaryDirectory(prefix="herdr-remote-origin-") as directory:
        root = Path(directory)
        checkout = root / "code" / "project"
        updater = root / "updater"
        origin = root / "origin.git"
        checkout.mkdir(parents=True)
        subprocess.run(["git", "init", "-q", "--bare", origin], check=True)
        subprocess.run(["git", "init", "-q", "-b", "main", checkout], check=True)
        subprocess.run(["git", "-C", checkout, "config", "user.name", "Test"], check=True)
        subprocess.run(["git", "-C", checkout, "config", "user.email", "test@example.com"], check=True)
        (checkout / "README.md").write_text("old\n")
        subprocess.run(["git", "-C", checkout, "add", "README.md"], check=True)
        subprocess.run(["git", "-C", checkout, "commit", "-q", "-m", "initial"], check=True)
        subprocess.run(["git", "-C", checkout, "remote", "add", "origin", str(origin)], check=True)
        subprocess.run(["git", "-C", checkout, "push", "-q", "-u", "origin", "main"], check=True)
        subprocess.run(["git", "--git-dir", origin, "symbolic-ref", "HEAD", "refs/heads/main"], check=True)
        subprocess.run(["git", "clone", "-q", origin, updater], check=True)
        subprocess.run(["git", "-C", updater, "config", "user.name", "Test"], check=True)
        subprocess.run(["git", "-C", updater, "config", "user.email", "test@example.com"], check=True)
        (updater / "README.md").write_text("new\n")
        subprocess.run(["git", "-C", updater, "commit", "-q", "-am", "latest"], check=True)
        subprocess.run(["git", "-C", updater, "push", "-q", "origin", "main"], check=True)

        env = {
            **os.environ,
            "HERDR_REMOTE_CODE_ROOT": str(root / "code"),
            "HERDR_REMOTE_WORKTREE_ROOT": str(root / "code" / "work"),
        }
        wrapper = DOTFILES / "bin/herdr-run-remote-codex-agent"
        result = subprocess.run(
            [
                wrapper,
                "--remote-worktree",
                "--repo-url",
                str(origin),
                "--branch",
                "thread/latest",
                "--base",
                "main",
                "--source",
                "origin",
                "--project-name",
                "project",
            ],
            env=env,
            text=True,
            check=True,
            capture_output=True,
        )

        worktree = Path(result.stdout.strip())
        assert (worktree / "README.md").read_text() == "new\n"
        worktree_head = subprocess.run(
            ["git", "-C", worktree, "rev-parse", "HEAD"],
            text=True,
            check=True,
            capture_output=True,
        ).stdout.strip()
        origin_head = subprocess.run(
            ["git", "--git-dir", origin, "rev-parse", "main"],
            text=True,
            check=True,
            capture_output=True,
        ).stdout.strip()
        assert worktree_head == origin_head


def test_focus_tab_launcher() -> None:
    sys.dont_write_bytecode = True
    path = DOTFILES / "bin/herdr-focus-tab"
    loader = SourceFileLoader("herdr_focus_tab", str(path))
    spec = importlib.util.spec_from_loader("herdr_focus_tab", loader)
    assert spec and spec.loader
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)

    calls: list[tuple[str, ...]] = []
    agents = [{"name": "dotfiles-codex", "tab_id": "somewhere-else"}]

    def fake_herdr(*arguments: str) -> dict[str, object]:
        calls.append(arguments)
        if arguments == ("agent", "list"):
            return {"result": {"agents": agents}}
        if arguments[:2] == ("pane", "run"):
            agents.append(
                {
                    "agent": "codex",
                    "pane_id": "proof:p2",
                    "tab_id": "proof:t1",
                    "name": "codex",
                }
            )
        return {}

    module.herdr = fake_herdr
    module.pane_for_tab = lambda _tab_id, timeout=0: {
        "pane_id": "proof:p2",
        "cwd": "/Users/boss/.dotfiles",
    }
    module.close_idle_sibling_panes = lambda *_args, **_kwargs: None
    module.pane_has_codex = lambda _pane_id: True
    module.ensure_managed_agent("proof:t1")

    assert (
        "pane",
        "run",
        "proof:p2",
        f"{DOTFILES}/bin/herdr-run-codex-agent --interactive "
        "--close-tab-on-exit --dangerously-bypass-approvals-and-sandbox",
    ) in calls
    assert ("agent", "rename", "proof:p2", "dotfiles-codex-2") in calls
    metadata = next(call for call in calls if call[:2] == ("pane", "report-metadata"))
    assert metadata[2:9] == (
        "proof:p2",
        "--source",
        "boss:codex-launch-title",
        "--agent",
        "codex",
        "--title",
        "dotfiles-codex-2",
    )
    assert ("agent", "focus", "proof:p2") in calls
    assert not any(call[:2] == ("agent", "start") for call in calls)


def test_focus_tab_keeps_selected_agent() -> None:
    sys.dont_write_bytecode = True
    path = DOTFILES / "bin/herdr-focus-tab"
    loader = SourceFileLoader("herdr_focus_tab_existing", str(path))
    spec = importlib.util.spec_from_loader("herdr_focus_tab_existing", loader)
    assert spec and spec.loader
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)

    calls: list[tuple[str, ...]] = []

    def fake_herdr(*arguments: str) -> dict[str, object]:
        calls.append(arguments)
        if arguments == ("agent", "list"):
            return {
                "result": {
                    "agents": [
                        {
                            "agent": "codex",
                            "pane_id": "proof:first-agent",
                            "tab_id": "proof:t1",
                        },
                        {
                            "agent": "codex",
                            "pane_id": "proof:selected-agent",
                            "tab_id": "proof:t1",
                        },
                    ]
                }
            }
        return {}

    module.herdr = fake_herdr
    module.pane_has_codex = lambda _pane_id: True
    module.close_idle_sibling_panes = lambda *_args, **_kwargs: None
    module.ensure_managed_agent("proof:t1")

    assert ("agent", "focus", "proof:first-agent") not in calls
    assert not any(call[:2] == ("pane", "run") for call in calls)


def test_focus_tab_reattaches_exact_remote_agent() -> None:
    sys.dont_write_bytecode = True
    path = DOTFILES / "bin/herdr-focus-tab"
    loader = SourceFileLoader("herdr_focus_tab_remote_agent", str(path))
    spec = importlib.util.spec_from_loader("herdr_focus_tab_remote_agent", loader)
    assert spec and spec.loader
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)

    calls: list[tuple[str, ...]] = []
    agents: list[dict[str, str]] = []

    def fake_herdr(*arguments: str) -> dict[str, object]:
        calls.append(arguments)
        if arguments == ("agent", "list"):
            return {"result": {"agents": agents}}
        if arguments[:2] == ("pane", "run"):
            agents.append({
                "agent": "codex",
                "pane_id": "local:p2",
                "tab_id": "local:t1",
                "name": "codex",
            })
        return {}

    module.herdr = fake_herdr
    module.pane_for_tab = lambda _tab_id, timeout=0: {
        "pane_id": "local:p2",
        "cwd": "/local/project",
    }
    module.close_idle_sibling_panes = lambda *_args, **_kwargs: None
    context = {
        "target": "ubuntu.test",
        "path": "/remote/worktree",
        "thread_key": "proof-thread",
        "remote_session": "default",
        "remote_pane_id": "remote:p2",
    }

    module.ensure_managed_agent("local:t1", context)

    command = next(call[3] for call in calls if call[:2] == ("pane", "run"))
    assert "--thread-key proof-thread" in command
    assert "--remote-pane remote:p2" in command
    assert "--session default" in command


def test_focus_tab_routes_remote_tools_to_remote_wrapper() -> None:
    sys.dont_write_bytecode = True
    path = DOTFILES / "bin/herdr-focus-tab"
    loader = SourceFileLoader("herdr_focus_tab_remote", str(path))
    spec = importlib.util.spec_from_loader("herdr_focus_tab_remote", loader)
    assert spec and spec.loader
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)

    calls: list[tuple[str, ...]] = []
    module.herdr = lambda *arguments: calls.append(arguments) or {}
    module.pane_is_idle = lambda _pane_id: True
    context = {
        "target": "ubuntu.test",
        "path": "/remote/worktree",
        "thread_key": "proof-thread",
        "remote_session": "default",
        "remote_pane_id": "remote:p2",
    }

    module.launch_default_command("proof:p4", "terminal", context)

    run_call = next(call for call in calls if call[:2] == ("pane", "run"))
    assert "herdr-run-remote-pane" in run_call[3]
    assert "--target ubuntu.test" in run_call[3]
    assert "--remote-path /remote/worktree" in run_call[3]
    assert "--kind terminal" in run_call[3]


def test_focus_tab_defers_remote_pane_lookup_until_after_focus() -> None:
    sys.dont_write_bytecode = True
    path = DOTFILES / "bin/herdr-focus-tab"
    loader = SourceFileLoader("herdr_focus_tab_remote_schedule", str(path))
    spec = importlib.util.spec_from_loader("herdr_focus_tab_remote_schedule", loader)
    assert spec and spec.loader
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)

    launches: list[list[str]] = []
    module.pane_for_tab = lambda *_args, **_kwargs: (_ for _ in ()).throw(
        AssertionError("parent resolved the pane before tab focus")
    )
    module.subprocess.Popen = lambda arguments, **_kwargs: launches.append(arguments)
    context = {
        "target": "ubuntu.test",
        "path": "/remote/worktree",
        "thread_key": "proof-thread",
        "remote_session": "default",
        "remote_pane_id": "remote:p2",
    }

    module.schedule_default_command({"tab_id": "proof:t5"}, "editor", context)

    assert launches == [[
        sys.executable,
        str(path),
        "--launch-tab",
        "proof:t5",
        "editor",
        "--context",
        json.dumps(context),
    ]]


def main() -> int:
    test_machine_launcher_starts_mac_codex()
    test_remote_wrapper_attaches_persistent_herdr_agent()
    test_remote_tool_wrapper_targets_same_worktree()
    test_remote_codex_monitor_reads_visible_status()
    test_ai_thread_title_is_cleaned_for_herdr()
    test_saved_thread_resumes_in_its_plain_path()
    test_saved_thread_from_bare_repo_uses_default_checkout()
    test_default_branch_origin_sync_refuses_dirty_checkout()
    test_default_branch_origin_sync_fast_forwards_clean_checkout()
    test_remote_project_resolution_requires_matching_branch()
    test_remote_worktree_is_created_and_reused()
    test_remote_worktree_origin_uses_latest_default_branch()
    test_focus_tab_launcher()
    test_focus_tab_keeps_selected_agent()
    test_focus_tab_reattaches_exact_remote_agent()
    test_focus_tab_routes_remote_tools_to_remote_wrapper()
    test_focus_tab_defers_remote_pane_lookup_until_after_focus()
    print("herdr-codex-launcher-regression-ok")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
