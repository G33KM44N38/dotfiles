#!/usr/bin/env python3
"""Read-only checks for the Codex → Herdr lifecycle chain."""

from __future__ import annotations

import json
import os
from pathlib import Path
import subprocess
import tomllib
import re


CODEX_HOME = Path(os.environ.get("CODEX_HOME", "/Users/boss/.codex"))
DOTFILES = Path("/Users/boss/.dotfiles")


def run(*command: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(command, text=True, capture_output=True, timeout=30)


def main() -> int:
    checks: list[dict[str, object]] = []

    def check(name: str, ok: bool, detail: str) -> None:
        checks.append({"name": name, "ok": ok, "detail": detail})

    config = tomllib.loads((CODEX_HOME / "config.toml").read_text())
    title = config.get("tui", {}).get("terminal_title")
    check(
        "codex_terminal_title",
        title == ["spinner", "project"],
        f"terminal_title={title!r}; expected ['spinner', 'project']",
    )

    detector_path = Path("/Users/boss/.config/herdr/agent-detection/codex.toml")
    try:
        detector = tomllib.loads(detector_path.read_text())
        detector_version = str(detector.get("version", ""))
        detector_rules = detector.get("rules", [])
        spinner_rule = next(
            (
                rule
                for rule in detector_rules
                if rule.get("id") == "osc_title_working_spinner"
            ),
            {},
        )
        spinner_patterns = spinner_rule.get("regex", [])
        spinner_pattern = (
            re.compile(spinner_patterns[0]) if spinner_patterns else None
        )
        detector_ok = bool(
            re.fullmatch(r"\d+(?:\.\d+)+", detector_version)
            and any(rule.get("id") == "osc_title_working_words" for rule in detector_rules)
            and any(rule.get("id") == "tui_status_working" for rule in detector_rules)
            and spinner_pattern
            and spinner_pattern.search("⠙ main-")
            and not spinner_pattern.search("main-")
        )
        detector_detail = (
            f"version={detector_version!r}; OSC spinner and TUI working rules present"
        )
    except (OSError, tomllib.TOMLDecodeError) as error:
        detector_ok = False
        detector_detail = f"cannot load local detector: {error}"
    check("herdr_codex_detector", detector_ok, detector_detail)

    integration = CODEX_HOME / "herdr-agent-state.sh"
    integration_text = integration.read_text() if integration.exists() else ""
    check(
        "herdr_codex_identity_v7",
        "HERDR_INTEGRATION_VERSION=7" in integration_text
        and "pane.report_agent_session" in integration_text,
        "v7 SessionStart identity reporter present",
    )

    hooks = json.loads((CODEX_HOME / "hooks.json").read_text())
    session_commands = [
        hook.get("command", "")
        for group in hooks.get("hooks", {}).get("SessionStart", [])
        for hook in group.get("hooks", [])
    ]
    check(
        "codex_session_identity_hook",
        any("herdr-agent-state.sh' session" in command for command in session_commands),
        "SessionStart invokes the managed Herdr identity integration",
    )
    expected_transitions = {
        "SessionStart": "start",
        "PermissionRequest": "blocked",
        "UserPromptSubmit": "working",
        "SubagentStart": "subagent-start",
        "SubagentStop": "subagent-stop",
    }
    lifecycle_commands = {
        event: [
            hook.get("command", "")
            for group in hooks.get("hooks", {}).get(event, [])
            for hook in group.get("hooks", [])
        ]
        for event in expected_transitions
    }
    check(
        "codex_lifecycle_hooks",
        all(
            any(
                "herdr-codex-lifecycle-hook" in command
                and command.endswith(f" {state}")
                for command in lifecycle_commands[event]
            )
            for event, state in expected_transitions.items()
        ),
        "Authoritative lifecycle hooks cover parent and Collaboration child transitions",
    )
    stop_commands = [
        hook.get("command", "")
        for group in hooks.get("hooks", {}).get("Stop", [])
        for hook in group.get("hooks", [])
    ]
    prompt_commands = [
        hook.get("command", "")
        for group in hooks.get("hooks", {}).get("UserPromptSubmit", [])
        for hook in group.get("hooks", [])
    ]
    check(
        "codex_ste_hooks",
        any(
            "codex-ste-hook" in command and command.endswith(" stop")
            for command in stop_commands
        )
        and any(
            "codex-ste-hook" in command and command.endswith(" prompt")
            for command in prompt_commands
        ),
        "UserPromptSubmit supplies STE rules and Stop verifies the reply before lifecycle completion",
    )

    wrapper = DOTFILES / "bin/herdr-run-codex-agent"
    wrapper_regression = DOTFILES / "bin/test-herdr-run-codex-agent"
    popup_launcher = DOTFILES / "bin/herdr-start-codex"
    focus_launcher = DOTFILES / "bin/herdr-focus-tab"
    launcher_regression = DOTFILES / "bin/test-herdr-codex-launchers"
    lifecycle_hook = DOTFILES / "bin/herdr-codex-lifecycle-hook"
    lifecycle_regression = DOTFILES / "bin/test-herdr-codex-lifecycle-hook"
    ste_hook = DOTFILES / "bin/codex-ste-hook"
    ste_regression = DOTFILES / "bin/test-codex-ste-hook"
    completion_sound = DOTFILES / "bin/herdr-agent-completion-sound"
    completion_sound_regression = DOTFILES / "bin/test-herdr-agent-completion-sound"
    wrapper_text = wrapper.read_text() if wrapper.exists() else ""
    lifecycle_hook_text = lifecycle_hook.read_text() if lifecycle_hook.exists() else ""
    completion_sound_text = completion_sound.read_text() if completion_sound.exists() else ""
    syntax = run("bash", "-n", str(wrapper)) if wrapper.exists() else None
    wrapper_ok = bool(
        syntax
        and syntax.returncode == 0
        and "--state working" in wrapper_text
        and "--state idle" in wrapper_text
        and "release-agent" in wrapper_text
        and "pane process-info" in wrapper_text
        and "report_working_when_codex_is_live" in wrapper_text
        and 'HERDR_CODEX_LIFECYCLE_OWNER="wrapper"' in wrapper_text
        and "--task-name" in wrapper_text
        and "pane report-metadata" in wrapper_text
        and "--applies-to-source" in wrapper_text
        and "main()" in wrapper_text
        and "codex_exit_code=$?" in wrapper_text
        and 'release_agent "$codex_exit_code"' in wrapper_text
        and str(completion_sound) in wrapper_text
        and wrapper_regression.is_file()
        and os.access(wrapper_regression, os.X_OK)
    )
    check(
        "programmatic_wrapper",
        wrapper_ok,
        "parsed main, process-confirmed working state, Herdr cleanup, and regression present",
    )

    launcher_test = (
        run(str(launcher_regression))
        if launcher_regression.is_file() and os.access(launcher_regression, os.X_OK)
        else None
    )
    popup_text = popup_launcher.read_text() if popup_launcher.exists() else ""
    focus_text = focus_launcher.read_text() if focus_launcher.exists() else ""
    check(
        "custom_interactive_launch_identity",
        bool(
            launcher_test
            and launcher_test.returncode == 0
            and "herdr-codex-launcher-regression-ok" in launcher_test.stdout
            and "herdr pane run" in popup_text
            and '"pane", "run"' in focus_text
            and "herdr-run-codex-agent" in popup_text
            and "herdr-run-codex-agent" in focus_text
            and "--interactive" in popup_text
            and "--close-tab-on-exit" in popup_text
            and "boss:codex-launch-title" in popup_text
            and "boss:codex-launch-title" in focus_text
            and "herdr agent start" not in popup_text
        ),
        (
            "interactive launchers use the custom close-on-exit wrapper plus matching launch metadata"
            if launcher_test and launcher_test.returncode == 0
            else f"regression failed: {launcher_test.stderr.strip() if launcher_test else 'missing or non-executable test'}"
        ),
    )

    try:
        compile(lifecycle_hook_text, str(lifecycle_hook), "exec")
        lifecycle_syntax = True
    except SyntaxError:
        lifecycle_syntax = False
    lifecycle_test = (
        run(str(lifecycle_regression))
        if lifecycle_regression.is_file()
        and os.access(lifecycle_regression, os.X_OK)
        else None
    )
    check(
        "collaboration_parent_child_lifecycle",
        bool(
            lifecycle_syntax
            and lifecycle_test
            and lifecycle_test.returncode == 0
            and "herdr-codex-parent-child-lifecycle-regression-ok"
            in lifecycle_test.stdout
        ),
        (
            "authoritative parent Stop stays working until every child stops"
            if lifecycle_test and lifecycle_test.returncode == 0
            else f"regression failed: {lifecycle_test.stderr.strip() if lifecycle_test else 'missing or non-executable test'}"
        ),
    )

    ste_hook_text = ste_hook.read_text() if ste_hook.exists() else ""
    try:
        compile(ste_hook_text, str(ste_hook), "exec")
        ste_syntax = True
    except SyntaxError:
        ste_syntax = False
    ste_test = (
        run(str(ste_regression))
        if ste_regression.is_file() and os.access(ste_regression, os.X_OK)
        else None
    )
    check(
        "codex_ste_feedback_loop",
        bool(
            ste_syntax
            and ste_hook.is_file()
            and os.access(ste_hook, os.X_OK)
            and ste_test
            and ste_test.returncode == 0
            and "codex-ste-hook-regression-ok" in ste_test.stdout
        ),
        (
            "Issue 9 prompt, structural checks, one-revision limit, and lifecycle handoff pass"
            if ste_test and ste_test.returncode == 0
            else f"regression failed: {ste_test.stderr.strip() if ste_test else 'missing or non-executable test'}"
        ),
    )

    try:
        compile(completion_sound_text, str(completion_sound), "exec")
        completion_sound_syntax = True
    except SyntaxError:
        completion_sound_syntax = False
    check(
        "active_tab_adjacent_pane_sound",
        completion_sound_syntax
        and "focused_tab_id != tab_id" in completion_sound_text
        and "focused_pane_id in (None, pane_id)" in completion_sound_text
        and str(completion_sound) in lifecycle_hook_text
        and str(completion_sound) in wrapper_text
        and completion_sound_regression.is_file()
        and os.access(completion_sound_regression, os.X_OK),
        "adjacent panes in the focused tab receive a completion sound without replacing Herdr background sounds",
    )

    integration_status = run("herdr", "integration", "status")
    check(
        "herdr_integration_status",
        integration_status.returncode == 0
        and any(
            line.startswith("codex: current (v7)")
            for line in integration_status.stdout.splitlines()
        ),
        "Herdr reports codex integration current (v7)",
    )

    agents = run("herdr", "agent", "list")
    try:
        json.loads(agents.stdout)
        agents_json = agents.returncode == 0
    except json.JSONDecodeError:
        agents_json = False
    check("herdr_agent_api", agents_json, "agent list returned valid JSON")

    ok = all(bool(item["ok"]) for item in checks)
    print(json.dumps({"ok": ok, "checks": checks}, indent=2))
    return 0 if ok else 1


if __name__ == "__main__":
    raise SystemExit(main())
