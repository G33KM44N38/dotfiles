#!/usr/bin/env bash
set -euo pipefail

lock_dir="/tmp/herdr-start-codex"
mkdir -p "$lock_dir"

if [[ -n "${HERDR_ACTIVE_WORKSPACE_ID:-}" && -n "${HERDR_ACTIVE_PANE_CWD:-}" ]]; then
  workspace_id="$HERDR_ACTIVE_WORKSPACE_ID"
  project_path="$HERDR_ACTIVE_PANE_CWD"
else
  current_json="$(herdr pane current)"
  IFS=$'\t' read -r workspace_id project_path < <(printf '%s\n' "$current_json" | python3 -c '
import json, sys

pane = json.load(sys.stdin)["result"]["pane"]
print(pane["workspace_id"], pane.get("foreground_cwd") or pane["cwd"], sep="\t")
')
fi

lock_path="$lock_dir/$workspace_id.lockdir"
if ! mkdir "$lock_path" 2>/dev/null; then
  lock_age="$(( $(date +%s) - $(stat -f %m "$lock_path" 2>/dev/null || printf '0') ))"
  if (( lock_age > 60 )); then
    rm -rf "$lock_path"
    mkdir "$lock_path" 2>/dev/null || exit 0
  else
    exit 0
  fi
fi
trap 'rm -rf "$lock_path"' EXIT

printf '\033[2J\033[H'
printf 'New Codex agent\n\n'

while true; do
  requested_name=""
  if ! IFS= read -r -p 'Name (Enter = automatic): ' requested_name; then
    exit 0
  fi

  agents_json="$(herdr agent list)"
  if agent_name="$(printf '%s\n' "$agents_json" | python3 -c '
import json, os, re, sys, unicodedata

agents = json.load(sys.stdin).get("result", {}).get("agents", [])
names = {
    agent.get("name")
    for agent in agents
    if agent.get("name")
}

requested = sys.argv[1].strip()
project = os.path.basename(sys.argv[2].rstrip(os.sep)).lstrip(".") or "workspace"
source = requested or f"{project}-codex"
ascii_name = unicodedata.normalize("NFKD", source).encode("ascii", "ignore").decode()
name = re.sub(r"[^a-z0-9_-]+", "-", ascii_name.lower()).strip("-_")
if not name or not name[0].isalpha():
    name = f"codex-{name}" if name else "codex-agent"
name = name[:32].rstrip("-_")
if requested and name in names:
    raise SystemExit(2)
suffix = 2
base = name
while name in names:
    ending = f"-{suffix}"
    prefix = base[: 32 - len(ending)].rstrip("-_")
    name = f"{prefix}{ending}"
    suffix += 1
print(name)
' "$requested_name" "$project_path")"; then
    break
  fi

  printf '\nName already in use. Choose another name.\n\n'
done

agent_tab_id="$(herdr tab list --workspace "$workspace_id" | python3 -c '
import json, sys

tabs = json.load(sys.stdin).get("result", {}).get("tabs", [])
for tab in tabs:
    if tab.get("label") == "agent":
        print(tab["tab_id"])
        break
')"

created_tab=false
if [[ -z "$agent_tab_id" ]]; then
  tab_json="$(herdr tab create \
    --workspace "$workspace_id" \
    --cwd "$project_path" \
    --label agent \
    --no-focus)"
  agent_tab_id="$(printf '%s\n' "$tab_json" | python3 -c '
import json, sys

data = json.load(sys.stdin).get("result", {})
tab = data.get("tab", data)
print(tab.get("tab_id", ""))
')"
  created_tab=true
fi

# Herdr 0.7.5 starts agents in an existing pane. A new tab gets its first pane
# asynchronously, while an existing agent tab needs a fresh sibling pane.
pane_id=""
for _ in {1..100}; do
  pane_id="$(herdr pane list --workspace "$workspace_id" | python3 -c '
import json, sys

tab_id = sys.argv[1]
for pane in json.load(sys.stdin).get("result", {}).get("panes", []):
    if pane.get("tab_id") == tab_id:
        print(pane["pane_id"])
        break
' "$agent_tab_id")"
  [[ -z "$pane_id" ]] || break
  sleep 0.05
done

if [[ -z "$pane_id" ]]; then
  printf '\nCould not find a pane in agent tab %s.\n' "$agent_tab_id" >&2
  [[ "$created_tab" == false ]] || herdr tab close "$agent_tab_id" >/dev/null 2>&1 || true
  exit 1
fi

if [[ "$created_tab" == false ]]; then
  split_json="$(herdr pane split "$pane_id" \
    --direction right \
    --cwd "$project_path" \
    --no-focus)"
  pane_id="$(printf '%s\n' "$split_json" | python3 -c '
import json, sys

data = json.load(sys.stdin).get("result", {})
pane = data.get("pane", data)
print(pane.get("pane_id", ""))
')"
fi

if [[ -z "$pane_id" ]]; then
  printf '\nCould not create a pane for %s.\n' "$agent_name" >&2
  [[ "$created_tab" == false ]] || herdr tab close "$agent_tab_id" >/dev/null 2>&1 || true
  exit 1
fi

# Pane creation precedes shell initialization. Wait until the pane can accept
# the custom wrapper command.
pane_ready=false
for _ in {1..200}; do
  process_json="$(herdr pane process-info --pane "$pane_id" 2>/dev/null || true)"
  if printf '%s\n' "$process_json" | python3 -c '
import json, sys

try:
    processes = json.load(sys.stdin)["result"]["process_info"]["foreground_processes"]
except (KeyError, TypeError, ValueError):
    raise SystemExit(1)

ready = len(processes) == 1 and processes[0].get("name") in {"bash", "fish", "sh", "zsh"}
raise SystemExit(0 if ready else 1)
' 2>/dev/null; then
    pane_ready=true
    break
  fi
  sleep 0.05
done

if [[ "$pane_ready" == false ]]; then
  printf '\nPane %s did not become ready for %s.\n' "$pane_id" "$agent_name" >&2
  if [[ "$created_tab" == true ]]; then
    herdr tab close "$agent_tab_id" >/dev/null 2>&1 || true
  else
    herdr pane close "$pane_id" >/dev/null 2>&1 || true
  fi
  exit 1
fi

launch_command="/Users/boss/.dotfiles/bin/herdr-run-codex-agent --interactive --close-tab-on-exit"
if ! herdr pane run "$pane_id" "$launch_command" >/dev/null; then
  printf '\nCould not start %s.\n' "$agent_name" >&2
  if [[ "$created_tab" == true ]]; then
    herdr tab close "$agent_tab_id" >/dev/null 2>&1 || true
  else
    herdr pane close "$pane_id" >/dev/null 2>&1 || true
  fi
  exit 1
fi

agent_started=false
for _ in {1..200}; do
  if herdr agent list | python3 -c '
import json, sys
pane_id = sys.argv[1]
agents = json.load(sys.stdin).get("result", {}).get("agents", [])
raise SystemExit(0 if any(
    agent.get("pane_id") == pane_id and agent.get("agent") == "codex"
    for agent in agents
) else 1)
' "$pane_id"; then
    agent_started=true
    break
  fi
  sleep 0.05
done

if [[ "$agent_started" == false ]]; then
  printf '\nCodex did not start in pane %s.\n' "$pane_id" >&2
  if [[ "$created_tab" == true ]]; then
    herdr tab close "$agent_tab_id" >/dev/null 2>&1 || true
  else
    herdr pane close "$pane_id" >/dev/null 2>&1 || true
  fi
  exit 1
fi

herdr agent rename "$pane_id" "$agent_name" >/dev/null
herdr pane report-metadata "$pane_id" \
  --source boss:codex-launch-title \
  --agent codex \
  --title "$agent_name" \
  --seq "$(python3 -c 'import time; print(time.time_ns())')" >/dev/null
herdr agent focus "$pane_id" >/dev/null
