#!/usr/bin/env bash
set -euo pipefail

readonly report_source="boss:remote-codex-wrapper"
readonly remote_code_root="${HERDR_REMOTE_CODE_ROOT:-$HOME/code}"
readonly remote_worktree_root="${HERDR_REMOTE_WORKTREE_ROOT:-$HOME/code/work}"
readonly remote_binding_root="${XDG_STATE_HOME:-$HOME/.local/state}/herdr/remote-thread-bindings"
readonly local_context_root="${XDG_STATE_HOME:-$HOME/.local/state}/herdr/remote-workspaces"
readonly installed_remote_runner="/home/kylian/.dotfiles/bin/herdr-run-remote-codex-agent"
readonly herdr_bin="${HERDR_BIN_PATH:-$(type -P herdr)}"
lifecycle_reporter_pid=

herdr() {
    "$herdr_bin" "$@"
}

usage() {
    printf 'Usage: %s --target <ssh-target> --remote-path <path> [--remote-pane <id>] [--thread-key <id>] [--session <name>] [--prompt <text>] [--title <text>] [--close-tab-on-exit]\n' "${0##*/}" >&2
    printf '       %s --remote-resolve --repo-url <url> --branch <branch> --project-name <name>\n' "${0##*/}" >&2
    printf '       %s --remote-default --repo-url <url> --branch <branch> --source <local|origin> --project-name <name>\n' "${0##*/}" >&2
    printf '       %s --remote-worktree --repo-url <url> --branch <branch> [--base <ref>] [--source <local|origin>] --project-name <name>\n' "${0##*/}" >&2
    printf '       %s --remote-start --remote-path <path> --thread-key <id> [--session <name>] [--prompt <text>] [--title <text>]\n' "${0##*/}" >&2
}

report_title() {
    local title=$1
    [[ -n "$title" ]] || return
    herdr pane report-metadata "$HERDR_PANE_ID" \
        --source boss:remote-codex-title \
        --agent codex \
        --applies-to-source "$report_source" \
        --title "$title" \
        --display-agent 'Ubuntu · Codex' \
        --seq "$(python3 -c 'import time; print(time.time_ns())')" >/dev/null 2>&1 || true
}

sync_remote_default() {
    local repo_url=$1 branch=$2 source_mode=$3 project_name=$4 checkout
    checkout="$(resolve_remote_project "$repo_url" "$branch" "$project_name")" || return
    if [[ "$source_mode" == origin ]]; then
        if [[ -n "$(git -C "$checkout" status --porcelain)" ]]; then
            printf 'The Ubuntu default branch checkout has local changes: %s\n' "$checkout" >&2
            return 1
        fi
        git -C "$checkout" fetch --prune origin "$branch" >/dev/null
        git -C "$checkout" merge --ff-only "origin/$branch" >/dev/null
    fi
    printf '%s\n' "$checkout"
}

normalize_repo_url() {
    python3 - "$1" <<'PY'
import re
import sys

value = sys.argv[1].strip()
value = re.sub(r"^ssh://(?:git@)?", "", value)
value = re.sub(r"^(?:https?|git)://", "", value)
value = re.sub(r"^[^@/]+@([^:]+):", r"\1/", value)
value = value.rstrip("/")
if value.endswith(".git"):
    value = value[:-4]
print(value.lower())
PY
}

resolve_remote_project() {
    local repo_url=$1 requested_branch=$2 project_name=$3
    local wanted_repo candidate marker candidate_url candidate_repo candidate_branch
    local first_repo_match= first_name_match= name_branch_match=

    wanted_repo="$(normalize_repo_url "$repo_url")"
    while IFS= read -r marker; do
        candidate=${marker%/.git}
        candidate_url="$(git -C "$candidate" remote get-url origin 2>/dev/null || true)"
        [[ -n "$candidate_url" ]] || continue
        candidate_repo="$(normalize_repo_url "$candidate_url")"
        candidate_branch="$(git -C "$candidate" branch --show-current 2>/dev/null || true)"

        if [[ "${candidate_repo##*/}" == "$project_name" ]]; then
            [[ -n "$first_name_match" ]] || first_name_match=$candidate
            if [[ -z "$requested_branch" || "$candidate_branch" == "$requested_branch" ]]; then
                [[ -n "$name_branch_match" ]] || name_branch_match=$candidate
            fi
        fi

        [[ "$candidate_repo" == "$wanted_repo" ]] || continue

        [[ -n "$first_repo_match" ]] || first_repo_match=$candidate
        if [[ -z "$requested_branch" || "$candidate_branch" == "$requested_branch" ]]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done < <(find "$remote_code_root" -maxdepth 6 \( -type d -o -type f \) -name .git -print 2>/dev/null | sort)

    if [[ -n "$first_repo_match" ]]; then
        candidate_branch="$(git -C "$first_repo_match" branch --show-current 2>/dev/null || true)"
        printf 'Ubuntu has %s on branch %s, not %s.\n' \
            "$first_repo_match" "${candidate_branch:-detached}" "${requested_branch:-detached}" >&2
        return 3
    fi

    if [[ -n "$name_branch_match" ]]; then
        printf '%s\n' "$name_branch_match"
        return 0
    fi

    if [[ -n "$first_name_match" ]]; then
        candidate_branch="$(git -C "$first_name_match" branch --show-current 2>/dev/null || true)"
        printf 'Ubuntu has %s on branch %s, not %s.\n' \
            "$first_name_match" "${candidate_branch:-detached}" "${requested_branch:-detached}" >&2
        return 3
    fi

    if [[ -z "$wanted_repo" && -d "$remote_code_root/$project_name" ]]; then
        printf '%s\n' "$remote_code_root/$project_name"
        return 0
    fi

    printf 'Ubuntu has no checkout for %s.\n' "${repo_url:-$project_name}" >&2
    return 4
}

ensure_remote_worktree() {
    local repo_url=$1 branch=$2 base=$3 project_name=$4 source_mode=$5 source_checkout bare_root
    local existing_path existing_branch slug worktree_path branch_exists=false base_ref

    [[ -n "$branch" ]] || {
        printf 'Ubuntu worktrees require a named branch.\n' >&2
        return 5
    }

    [[ -n "$base" ]] || base=$branch
    source_checkout="$(resolve_remote_project "$repo_url" "$base" "$project_name")" || return
    bare_root="$remote_worktree_root/$project_name.git"
    mkdir -p "$remote_worktree_root"

    if [[ ! -d "$bare_root" ]]; then
        git clone --bare "$source_checkout" "$bare_root" >/dev/null
        if [[ -n "$repo_url" ]]; then
            git -C "$bare_root" remote set-url origin "$repo_url"
        fi
    fi

    base_ref="$base"
    if [[ "$source_mode" == origin ]]; then
        git -C "$bare_root" fetch --prune origin \
            "refs/heads/$base:refs/remotes/origin/$base" >/dev/null
        base_ref="origin/$base"
    elif ! git -C "$bare_root" show-ref --verify --quiet "refs/heads/$base"; then
        git -C "$bare_root" fetch "$source_checkout" \
            "refs/heads/$base:refs/heads/$base" >/dev/null
    fi
    if git -C "$bare_root" show-ref --verify --quiet "refs/heads/$branch"; then
        branch_exists=true
    fi

    existing_path="$(git -C "$bare_root" worktree list --porcelain | python3 -c '
import sys

branch = sys.argv[1]
path = ""
for line in sys.stdin:
    line = line.rstrip("\n")
    if line.startswith("worktree "):
        path = line.removeprefix("worktree ")
    elif line == f"branch refs/heads/{branch}":
        print(path)
        break
' "$branch")"
    if [[ -n "$existing_path" ]]; then
        printf '%s\n' "$existing_path"
        return 0
    fi

    slug="$(python3 - "$branch" <<'PY'
import re
import sys

slug = re.sub(r"[^A-Za-z0-9._-]+", "-", sys.argv[1]).strip("-.")
print(slug or "branch")
PY
)"
    worktree_path="$bare_root/$slug"
    if [[ -e "$worktree_path" ]]; then
        existing_branch="$(git -C "$worktree_path" branch --show-current 2>/dev/null || true)"
        printf 'Ubuntu path %s already belongs to branch %s.\n' \
            "$worktree_path" "${existing_branch:-unknown}" >&2
        return 6
    fi

    if [[ "$branch_exists" == true ]]; then
        git -C "$bare_root" worktree add "$worktree_path" "$branch" >/dev/null
    else
        git -C "$bare_root" worktree add -b "$branch" "$worktree_path" "$base_ref" >/dev/null
    fi
    worktree_path="$(cd "$worktree_path" && pwd -P)"
    printf '%s\n' "$worktree_path"
}

can_report() {
    [[ "${HERDR_ENV:-}" == "1" ]] &&
        [[ -n "${HERDR_PANE_ID:-}" ]] &&
        command -v herdr >/dev/null 2>&1
}

report_state() {
    local state=$1 message=${2:-"Remote Codex is $1"}
    herdr pane report-agent "$HERDR_PANE_ID" \
        --source "$report_source" \
        --agent codex \
        --state "$state" \
        --message "$message" >/dev/null 2>&1 || true
}

mirror_remote_agent_state() {
    local wrapper_pid=$1 target=$2 session=$3 agents_json state previous_state=
    while kill -0 "$wrapper_pid" >/dev/null 2>&1; do
        agents_json="$(ssh -o BatchMode=yes -o ConnectTimeout=2 "$target" \
            "HERDR_SESSION=$(printf '%q' "$session") /usr/local/bin/herdr agent list" 2>/dev/null || true)"
        state="$(printf '%s\n' "$agents_json" | python3 -c '
import json, sys

try:
    agents = json.load(sys.stdin).get("result", {}).get("agents", [])
except (json.JSONDecodeError, TypeError, AttributeError):
    print("")
    raise SystemExit

states = {agent.get("agent_status") for agent in agents}
if "blocked" in states:
    print("blocked")
elif "working" in states:
    print("working")
else:
    print("idle")
' 2>/dev/null || true)"
        if [[ -n "$state" && "$state" != "$previous_state" ]]; then
            report_state "$state"
            previous_state=$state
        fi
        sleep 0.5
    done
}

start_lifecycle_reporter() {
    local target=$1 session=$2
    mirror_remote_agent_state "$$" "$target" "$session" &
    lifecycle_reporter_pid=$!
}

stop_lifecycle_reporter() {
    if [[ -n "$lifecycle_reporter_pid" ]]; then
        kill "$lifecycle_reporter_pid" >/dev/null 2>&1 || true
        wait "$lifecycle_reporter_pid" 2>/dev/null || true
        lifecycle_reporter_pid=
    fi
}

release_agent() {
    stop_lifecycle_reporter
    if can_report; then
        herdr pane report-agent "$HERDR_PANE_ID" \
            --source "$report_source" \
            --agent codex \
            --state idle \
            --message "Remote Codex task finished" >/dev/null 2>&1 || true
        herdr pane release-agent "$HERDR_PANE_ID" \
            --source "$report_source" \
            --agent codex >/dev/null 2>&1 || true
    fi
}

close_interactive_container() {
    local agents_json close_scope

    if ! can_report || [[ -z "${HERDR_TAB_ID:-}" ]]; then
        return
    fi

    if agents_json="$(herdr agent list 2>/dev/null)"; then
        close_scope="$(printf '%s\n' "$agents_json" | python3 -c '
import json, sys

tab_id, pane_id = sys.argv[1:]
try:
    agents = json.load(sys.stdin)["result"]["agents"]
except (json.JSONDecodeError, KeyError, TypeError):
    print("pane")
    raise SystemExit

has_sibling_agent = any(
    agent.get("tab_id") == tab_id and agent.get("pane_id") != pane_id
    for agent in agents
)
print("pane" if has_sibling_agent else "tab")
' "$HERDR_TAB_ID" "$HERDR_PANE_ID")"
    else
        close_scope=pane
    fi

    if [[ "$close_scope" == "tab" ]]; then
        herdr tab close "$HERDR_TAB_ID" >/dev/null 2>&1 || true
    else
        herdr pane close "$HERDR_PANE_ID" >/dev/null 2>&1 || true
    fi
}

remote_start() {
    local remote_path=$1 session=$2 prompt=$3 title=$4 thread_key=$5
    local binding_path= workspace_id= pane_id= resume_session= workspace_json agent_json
    local -a start_arguments
    export HERDR_SESSION=$session

    mkdir -p "$remote_binding_root"
    chmod 0700 "$remote_binding_root"
    binding_path="$(python3 - "$remote_binding_root" "$thread_key" <<'PY'
import hashlib
import os
import sys

root, key = sys.argv[1:]
print(os.path.join(root, hashlib.sha256(key.encode()).hexdigest() + ".json"))
PY
)"

    if [[ -f "$binding_path" ]]; then
        IFS=$'\t' read -r workspace_id pane_id resume_session < <(python3 - "$binding_path" <<'PY'
import json
import sys

try:
    binding = json.load(open(sys.argv[1], encoding="utf-8"))
except (OSError, ValueError):
    binding = {}
print(
    binding.get("workspace_id", ""),
    binding.get("pane_id", ""),
    binding.get("agent_session", ""),
    sep="\t",
)
PY
)
    fi

    if [[ -n "$pane_id" ]] && agent_json="$(herdr agent get "$pane_id" 2>/dev/null)"; then
        python3 - "$thread_key" "$session" "$agent_json" <<'PY'
import json
import sys

agent = json.loads(sys.argv[3]).get("result", {}).get("agent", {})
print(json.dumps({
    "thread_key": sys.argv[1],
    "session": sys.argv[2],
    "workspace_id": agent.get("workspace_id", ""),
    "pane_id": agent.get("pane_id", ""),
    "agent_name": agent.get("name", ""),
    "agent_session": (agent.get("agent_session") or {}).get("value", ""),
}))
PY
        return
    fi

    if [[ -n "$workspace_id" ]]; then
        workspace_id="$(herdr workspace list | python3 -c '
import json, sys
wanted = sys.argv[1]
workspaces = json.load(sys.stdin).get("result", {}).get("workspaces", [])
print(wanted if any(item.get("workspace_id") == wanted for item in workspaces) else "")
' "$workspace_id")"
    fi

    if [[ -z "$workspace_id" ]]; then
        [[ -n "$title" ]] || title="$(git -C "$remote_path" branch --show-current 2>/dev/null || basename "$remote_path")"
        workspace_json="$(herdr workspace create \
            --cwd "$remote_path" \
            --label "${title:-Thread}" \
            --no-focus)"
        workspace_id="$(printf '%s\n' "$workspace_json" | python3 -c '
import json, sys
result = json.load(sys.stdin).get("result", {})
print(result.get("workspace", result).get("workspace_id", ""))
')"
    fi

    [[ -n "$workspace_id" ]] || {
        printf 'Could not create the Ubuntu Herdr workspace.\n' >&2
        return 1
    }

    start_arguments=(mac)
    [[ -z "$title" ]] || start_arguments+=(--thread-title "$title")
    if [[ -n "$resume_session" ]]; then
        start_arguments+=(--resume "$resume_session")
    elif [[ -n "$prompt" ]]; then
        start_arguments+=(--prompt "$prompt")
    fi
    HERDR_ACTIVE_WORKSPACE_ID=$workspace_id \
        HERDR_ACTIVE_PANE_CWD=$remote_path \
        "$HOME/.dotfiles/bin/herdr-start-codex" "${start_arguments[@]}" >/dev/null

    agent_json=
    for _ in {1..200}; do
        agent_json="$(herdr agent list | python3 -c '
import json, sys
workspace_id = sys.argv[1]
for agent in json.load(sys.stdin).get("result", {}).get("agents", []):
    if agent.get("workspace_id") == workspace_id and agent.get("agent") == "codex":
        print(json.dumps(agent))
        break
' "$workspace_id")"
        [[ -z "$agent_json" ]] || break
        sleep 0.05
    done
    [[ -n "$agent_json" ]] || {
        printf 'Could not start Codex in the Ubuntu Herdr workspace.\n' >&2
        return 1
    }

    python3 - "$binding_path" "$thread_key" "$session" "$agent_json" <<'PY'
import json
import os
import sys

path, thread_key, session, raw_agent = sys.argv[1:]
agent = json.loads(raw_agent)
binding = {
    "thread_key": thread_key,
    "session": session,
    "workspace_id": agent.get("workspace_id", ""),
    "pane_id": agent.get("pane_id", ""),
    "agent_name": agent.get("name", ""),
    "agent_session": (agent.get("agent_session") or {}).get("value", ""),
}
temporary = path + ".tmp"
with open(temporary, "w", encoding="utf-8") as stream:
    json.dump(binding, stream)
    stream.write("\n")
os.chmod(temporary, 0o600)
os.replace(temporary, path)
print(json.dumps(binding))
PY
}

provision_remote_agent() {
    local target=$1 remote_path=$2 session=$3 thread_key=$4 prompt=$5 title=$6
    local remote_command
    printf -v remote_command '%q ' \
        "$installed_remote_runner" \
        --remote-start \
        --remote-path "$remote_path" \
        --session "$session" \
        --thread-key "$thread_key"
    [[ -z "$prompt" ]] || printf -v remote_command '%s--prompt %q ' "$remote_command" "$prompt"
    [[ -z "$title" ]] || printf -v remote_command '%s--title %q ' "$remote_command" "$title"
    ssh -o BatchMode=yes -o ConnectTimeout=5 "$target" "$remote_command"
}

save_local_binding() {
    local workspace_id=$1 target=$2 remote_path=$3 binding_json=$4
    [[ -n "$workspace_id" ]] || return
    mkdir -p "$local_context_root"
    python3 - "$local_context_root/$workspace_id.json" "$target" "$remote_path" "$binding_json" <<'PY'
import json
import os
import sys

path, target, remote_path, raw_binding = sys.argv[1:]
try:
    context = json.load(open(path, encoding="utf-8"))
except (OSError, ValueError):
    context = {}
binding = json.loads(raw_binding)
context.update({
    "target": target,
    "path": remote_path,
    "remote_session": binding.get("session", "default"),
    "remote_workspace_id": binding.get("workspace_id", ""),
    "remote_pane_id": binding.get("pane_id", ""),
    "remote_agent_name": binding.get("agent_name", ""),
    "thread_key": binding.get("thread_key", ""),
})
temporary = path + ".tmp"
with open(temporary, "w", encoding="utf-8") as stream:
    json.dump(context, stream)
    stream.write("\n")
os.chmod(temporary, 0o600)
os.replace(temporary, path)
PY
}

main() {
    if [[ "${1:-}" == "--remote-resolve" ]]; then
        shift
        local repo_url= branch= project_name=
        while (( $# )); do
            case "$1" in
                --repo-url) repo_url=${2:-}; shift 2 ;;
                --branch) branch=${2:-}; shift 2 ;;
                --project-name) project_name=${2:-}; shift 2 ;;
                *) usage; return 2 ;;
            esac
        done
        resolve_remote_project "$repo_url" "$branch" "$project_name"
        return
    fi

    if [[ "${1:-}" == "--remote-default" ]]; then
        shift
        local repo_url= branch= source_mode=local project_name=
        while (( $# )); do
            case "$1" in
                --repo-url) repo_url=${2:-}; shift 2 ;;
                --branch) branch=${2:-}; shift 2 ;;
                --source) source_mode=${2:-}; shift 2 ;;
                --project-name) project_name=${2:-}; shift 2 ;;
                *) usage; return 2 ;;
            esac
        done
        sync_remote_default "$repo_url" "$branch" "$source_mode" "$project_name"
        return
    fi

    if [[ "${1:-}" == "--remote-worktree" ]]; then
        shift
        local repo_url= branch= base= source_mode=local project_name=
        while (( $# )); do
            case "$1" in
                --repo-url) repo_url=${2:-}; shift 2 ;;
                --branch) branch=${2:-}; shift 2 ;;
                --base) base=${2:-}; shift 2 ;;
                --source) source_mode=${2:-}; shift 2 ;;
                --project-name) project_name=${2:-}; shift 2 ;;
                *) usage; return 2 ;;
            esac
        done
        ensure_remote_worktree "$repo_url" "$branch" "$base" "$project_name" "$source_mode"
        return
    fi

    if [[ "${1:-}" == "--remote-start" ]]; then
        shift
        local remote_path= session=default prompt= title= thread_key=
        while (( $# )); do
            case "$1" in
                --remote-path) remote_path=${2:-}; shift 2 ;;
                --session) session=${2:-}; shift 2 ;;
                --prompt) prompt=${2:-}; shift 2 ;;
                --title) title=${2:-}; shift 2 ;;
                --thread-key) thread_key=${2:-}; shift 2 ;;
                *) usage; return 2 ;;
            esac
        done
        [[ -n "$remote_path" && -n "$thread_key" ]] || { usage; return 2; }
        remote_start "$remote_path" "$session" "$prompt" "$title" "$thread_key"
        return
    fi

    local target= remote_path= remote_pane= thread_key= session=default
    local prompt= title= close_tab_on_exit=false
    while (( $# )); do
        case "$1" in
            --target) target=${2:-}; shift 2 ;;
            --session) session=${2:-}; shift 2 ;;
            --remote-path) remote_path=${2:-}; shift 2 ;;
            --remote-pane) remote_pane=${2:-}; shift 2 ;;
            --thread-key) thread_key=${2:-}; shift 2 ;;
            --prompt) prompt=${2:-}; shift 2 ;;
            --title) title=${2:-}; shift 2 ;;
            --close-tab-on-exit) close_tab_on_exit=true; shift ;;
            *) usage; return 2 ;;
        esac
    done
    [[ -n "$target" && -n "$remote_path" ]] || { usage; return 2; }
    thread_key="${thread_key:-${HERDR_WORKSPACE_ID:-}}"
    [[ -n "$thread_key" ]] || {
        printf 'A stable local workspace id is required for the remote thread.\n' >&2
        return 2
    }

    if can_report; then
        report_state working
        report_title "$title"
        "$HOME/.dotfiles/bin/herdr-monitor-remote-codex" \
            --pane "$HERDR_PANE_ID" \
            --owner-pid "$$" &
        lifecycle_reporter_pid=$!
    fi

    local binding_json remote_workspace remote_agent remote_command codex_exit_code=0
    if [[ -z "$remote_pane" ]]; then
        if ! binding_json="$(provision_remote_agent \
            "$target" "$remote_path" "$session" "$thread_key" "$prompt" "$title")"; then
            stop_lifecycle_reporter
            report_state unknown "Ubuntu is disconnected"
            return 1
        fi
        IFS=$'\t' read -r remote_workspace remote_pane remote_agent < <(printf '%s\n' "$binding_json" | python3 -c '
import json, sys
binding = json.load(sys.stdin)
print(
    binding.get("workspace_id", ""),
    binding.get("pane_id", ""),
    binding.get("agent_name", ""),
    sep="\t",
)
')
        [[ -n "$remote_pane" ]] || {
            stop_lifecycle_reporter
            printf 'Ubuntu returned no persistent agent pane.\n' >&2
            return 1
        }
        save_local_binding "${HERDR_WORKSPACE_ID:-}" "$target" "$remote_path" "$binding_json"
    fi

    printf -v remote_command \
        'export HERDR_SESSION=%q; exec /usr/local/bin/herdr agent attach %q --takeover' \
        "$session" "$remote_pane"
    while true; do
        set +e
        ssh -tt \
            -o BatchMode=yes \
            -o ConnectTimeout=5 \
            -o ServerAliveInterval=5 \
            -o ServerAliveCountMax=3 \
            "$target" "$remote_command"
        codex_exit_code=$?
        set -e

        if ! ssh -o BatchMode=yes -o ConnectTimeout=3 "$target" true >/dev/null 2>&1; then
            report_state unknown "Ubuntu is disconnected"
            sleep 2
            continue
        fi
        if ssh -o BatchMode=yes "$target" \
            "HERDR_SESSION=$(printf '%q' "$session") /usr/local/bin/herdr agent get $(printf '%q' "$remote_pane")" \
            >/dev/null 2>&1; then
            report_state unknown "Reconnecting to Ubuntu"
            sleep 1
            continue
        fi
        break
    done

    stop_lifecycle_reporter
    release_agent
    if [[ "$close_tab_on_exit" == true ]]; then
        close_interactive_container
    fi
    return "$codex_exit_code"
}

main "$@"
