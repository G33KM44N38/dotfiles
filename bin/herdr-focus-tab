#!/usr/bin/env python3
import fcntl
import json
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys
import time


ALIASES = {
    "run": "terminal",
    "terminal-run": "terminal",
    "long": "process",
    "long-process": "process",
    "misc": "diff",
    "notes": "diff",
    "scratch": "diff",
}

DEFAULT_COMMANDS = {
    "editor": "nvim .",
    "diff": "hunk diff --watch",
}

SHELL_NAMES = {"bash", "fish", "nu", "pwsh", "sh", "zsh"}
LAUNCH_TITLE_SOURCE = "boss:codex-launch-title"
REMOTE_SUFFIX = " · Ubuntu"
REMOTE_CONTEXT_ROOT = (
    Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
    / "herdr/remote-workspaces"
)


def herdr(*args):
    result = subprocess.run(
        ["herdr", *args],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if result.returncode != 0:
        raise SystemExit(result.stderr.strip() or result.stdout.strip())
    output = result.stdout.strip()
    return json.loads(output) if output else {}


def current_workspace_id():
    return herdr("pane", "current", "--current")["result"]["pane"]["workspace_id"]


def base_tab_label(label):
    return (label or "").split(" · ", 1)[0].lower()


def tab_for_label(workspace_id, label):
    tabs = herdr("tab", "list", "--workspace", workspace_id)["result"]["tabs"]
    for tab in tabs:
        if base_tab_label(tab.get("label")) == label:
            return tab
    return None


def registered_tab(context, label):
    tab_id = (context.get("tabs") or {}).get(label)
    if not tab_id:
        return None
    try:
        tab = herdr("tab", "get", tab_id)["result"]["tab"]
    except (KeyError, SystemExit):
        return None
    return tab if base_tab_label(tab.get("label")) == label else None


def register_tab(workspace_id, context, label, tab):
    if not context:
        return
    context.setdefault("tabs", {})[label] = tab["tab_id"]
    save_remote_context(workspace_id, context)


def save_remote_context(workspace_id, context):
    REMOTE_CONTEXT_ROOT.mkdir(parents=True, exist_ok=True)
    path = REMOTE_CONTEXT_ROOT / f"{workspace_id}.json"
    temporary = path.with_suffix(".tmp")
    temporary.write_text(json.dumps(context) + "\n")
    temporary.chmod(0o600)
    temporary.replace(path)


def discover_remote_context(workspace_id):
    panes = herdr("pane", "list", "--workspace", workspace_id)["result"]["panes"]
    for pane in panes:
        try:
            processes = herdr("pane", "process-info", "--pane", pane["pane_id"])["result"][
                "process_info"
            ].get("foreground_processes", [])
        except SystemExit:
            continue
        for process in processes:
            arguments = process.get("argv") or []
            for index, argument in enumerate(arguments):
                if os.path.basename(argument) != "herdr-run-remote-codex-agent":
                    continue
                try:
                    context = {
                        "target": arguments[arguments.index("--target", index) + 1],
                        "path": arguments[arguments.index("--remote-path", index) + 1],
                    }
                except (ValueError, IndexError):
                    continue
                optional_fields = {
                    "--remote-pane": "remote_pane_id",
                    "--thread-key": "thread_key",
                    "--session": "remote_session",
                }
                for flag, field in optional_fields.items():
                    try:
                        context[field] = arguments[arguments.index(flag, index) + 1]
                    except (ValueError, IndexError):
                        pass
                save_remote_context(workspace_id, context)
                return context
    return None


def remote_context(workspace_id):
    path = REMOTE_CONTEXT_ROOT / f"{workspace_id}.json"
    try:
        context = json.loads(path.read_text())
        if context.get("target") and context.get("path"):
            return context
    except (OSError, json.JSONDecodeError, AttributeError):
        pass
    return discover_remote_context(workspace_id)


def mark_remote_workspace(workspace_id, context):
    if not context:
        return
    workspaces = herdr("workspace", "list")["result"]["workspaces"]
    workspace = next(
        (item for item in workspaces if item.get("workspace_id") == workspace_id), None
    )
    if workspace and not (workspace.get("label") or "").endswith(REMOTE_SUFFIX):
        herdr("workspace", "rename", workspace_id, workspace.get("label", "Thread") + REMOTE_SUFFIX)


def pane_for_tab(tab_id, timeout=0):
    deadline = time.monotonic() + timeout
    while True:
        panes = herdr("pane", "list")["result"]["panes"]
        pane = next((pane for pane in panes if pane.get("tab_id") == tab_id), None)
        if pane is not None or time.monotonic() >= deadline:
            return pane
        time.sleep(0.05)


def pane_is_idle(pane_id):
    processes = herdr("pane", "process-info", "--pane", pane_id)["result"][
        "process_info"
    ].get("foreground_processes", [])
    return not any(
        (process.get("name") or "").lower() not in SHELL_NAMES
        for process in processes
    )


def pane_has_codex(pane_id):
    try:
        processes = herdr("pane", "process-info", "--pane", pane_id)["result"][
            "process_info"
        ].get("foreground_processes", [])
    except SystemExit:
        return False

    return any(
        (process.get("name") or "").lower() == "codex" for process in processes
    )


def unique_agent_name(pane, agents):
    project = os.path.basename(
        (pane.get("foreground_cwd") or pane.get("cwd") or "workspace").rstrip("/")
    ).lstrip(".")
    slug = re.sub(r"[^a-z0-9_-]+", "-", project.lower()).strip("-_")
    base = f"{slug or 'workspace'}-codex"[:32].rstrip("-_")
    names = {agent.get("name") for agent in agents if agent.get("name")}
    if base not in names:
        return base

    suffix = 2
    while True:
        ending = f"-{suffix}"
        candidate = f"{base[: 32 - len(ending)].rstrip('-_')}{ending}"
        if candidate not in names:
            return candidate
        suffix += 1


def publish_launch_title(pane_id, agent_name, context=None):
    arguments = [
        "pane",
        "report-metadata",
        pane_id,
        "--source",
        LAUNCH_TITLE_SOURCE,
        "--agent",
        "codex",
        "--title",
        agent_name,
    ]
    if context:
        arguments.extend(("--display-agent", "Ubuntu · Codex", "--token", "machine=Ubuntu"))
    arguments.extend(("--seq", str(time.time_ns())))
    herdr(*arguments)


def remote_pane_command(label, context):
    return " ".join(
        (
            shlex.quote(str(Path(__file__).with_name("herdr-run-remote-pane"))),
            "--target",
            shlex.quote(context["target"]),
            "--remote-path",
            shlex.quote(context["path"]),
            "--kind",
            shlex.quote(label),
        )
    )


def launch_default_command(pane_id, label, context=None):
    command = remote_pane_command(label, context) if context else DEFAULT_COMMANDS.get(label)
    if command is None or not pane_is_idle(pane_id):
        return

    herdr("pane", "run", pane_id, command)

    if label == "diff":
        # Hunk hides its file explorer below its full-width breakpoint. The
        # shortcut forces it open once the TUI has mounted.
        time.sleep(0.5)
        herdr("pane", "send-keys", pane_id, "s")


def launch_tab_command(tab_id, label, context=None):
    lock_name = re.sub(r"[^a-zA-Z0-9_-]+", "-", tab_id)
    with open(f"/tmp/herdr-focus-tab-launch-{lock_name}.lock", "a+") as lock_file:
        fcntl.flock(lock_file, fcntl.LOCK_EX)
        pane = pane_for_tab(tab_id, timeout=5)
        if pane is None:
            raise RuntimeError(f"{label} tab {tab_id} did not create a pane")
        launch_default_command(pane["pane_id"], label, context)
        if context:
            deadline = time.monotonic() + 2
            while pane_is_idle(pane["pane_id"]) and time.monotonic() < deadline:
                time.sleep(0.05)


def close_idle_sibling_panes(tab_id, agent_pane_id, timeout=0):
    deadline = time.monotonic() + timeout
    while True:
        panes = herdr("pane", "list")["result"]["panes"]
        for pane in panes:
            pane_id = pane.get("pane_id")
            if (
                pane.get("tab_id") == tab_id
                and pane_id != agent_pane_id
                and pane_is_idle(pane_id)
            ):
                herdr("pane", "close", pane_id)
                return

        if time.monotonic() >= deadline:
            return
        time.sleep(0.05)


def launch_managed_agent(tab_id, context=None):
    # Multiple quick keypresses can start multiple detached workers. Serialize
    # provisioning so the tab's existing pane receives the command only once.
    with open("/tmp/herdr-focus-tab-agent.lock", "a+") as lock_file:
        fcntl.flock(lock_file, fcntl.LOCK_EX)
        ensure_managed_agent(tab_id, context)


def ensure_managed_agent(tab_id, context=None):
    agents = herdr("agent", "list")["result"]["agents"]
    agent = next(
        (
            agent
            for agent in agents
            if agent.get("tab_id") == tab_id and agent.get("agent") == "codex"
        ),
        None,
    )
    if agent is not None and (context or pane_has_codex(agent["pane_id"])):
        close_idle_sibling_panes(tab_id, agent["pane_id"])
        # The tab switch restores its pane history. Do not override that
        # choice with the first agent returned by `agent list`.
        return

    # Herdr materializes a newly-created tab's first pane asynchronously, and
    # sometimes only after the tab has been focused. The parent process focuses
    # the tab immediately after starting this worker, so wait for readiness
    # instead of treating a missing pane as a no-op.
    pane = pane_for_tab(tab_id, timeout=5)
    if pane is None:
        raise RuntimeError(f"agent tab {tab_id} did not create a pane")

    agent_name = unique_agent_name(pane, agents)
    if context:
        arguments = [
            str(Path(__file__).with_name("herdr-run-remote-codex-agent")),
            "--target",
            context["target"],
            "--remote-path",
            context["path"],
            "--session",
            context.get("remote_session", "default"),
            "--thread-key",
            context.get("thread_key") or os.environ.get("HERDR_WORKSPACE_ID", ""),
            "--close-tab-on-exit",
            "--title",
            "Ubuntu Codex",
        ]
        if context.get("remote_pane_id"):
            arguments.extend(("--remote-pane", context["remote_pane_id"]))
        command = shlex.join(arguments)
    else:
        command = " ".join(
            (
                shlex.quote(str(Path(__file__).with_name("herdr-run-codex-agent"))),
                "--interactive",
                "--close-tab-on-exit",
                "--dangerously-bypass-approvals-and-sandbox",
            )
        )
    herdr("pane", "run", pane["pane_id"], command)
    deadline = time.monotonic() + 5
    while time.monotonic() < deadline:
        agents = herdr("agent", "list")["result"]["agents"]
        agent = next(
            (
                agent
                for agent in agents
                if agent.get("tab_id") == tab_id
                and agent.get("agent") == "codex"
                and agent.get("pane_id") == pane["pane_id"]
                and (context or pane_has_codex(agent["pane_id"]))
            ),
            None,
        )
        if agent is not None:
            herdr("agent", "rename", agent["pane_id"], agent_name)
            publish_launch_title(agent["pane_id"], agent_name, context)
            close_idle_sibling_panes(tab_id, agent["pane_id"])
            herdr("agent", "focus", agent["pane_id"])
            return
        time.sleep(0.05)
    raise RuntimeError(f"Codex did not start in agent tab {tab_id}")


def schedule_default_command(tab, label, context=None):
    if label == "agent":
        remote_arguments = ["--context", json.dumps(context)] if context else []
        subprocess.Popen(
            [
                sys.executable,
                __file__,
                "--managed-agent",
                tab["tab_id"],
                *remote_arguments,
            ],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        return

    if not context and label not in DEFAULT_COMMANDS:
        return

    # Focus creates the first pane asynchronously. Resolve it inside the
    # detached worker after the parent focuses the tab.
    remote_arguments = ["--context", json.dumps(context)] if context else []
    subprocess.Popen(
        [sys.executable, __file__, "--launch-tab", tab["tab_id"], label, *remote_arguments],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def main():
    if len(sys.argv) in (3, 5) and sys.argv[1] == "--managed-agent":
        context = json.loads(sys.argv[4]) if len(sys.argv) == 5 and sys.argv[3] == "--context" else None
        launch_managed_agent(sys.argv[2], context)
        return 0

    if len(sys.argv) in (4, 6) and sys.argv[1] == "--launch":
        context = json.loads(sys.argv[5]) if len(sys.argv) == 6 and sys.argv[4] == "--context" else None
        time.sleep(0.1)
        launch_default_command(sys.argv[2], sys.argv[3], context)
        return 0

    if len(sys.argv) in (4, 6) and sys.argv[1] == "--launch-tab":
        context = json.loads(sys.argv[5]) if len(sys.argv) == 6 and sys.argv[4] == "--context" else None
        launch_tab_command(sys.argv[2], sys.argv[3], context)
        return 0

    if len(sys.argv) != 2:
        print("usage: herdr-focus-tab editor|agent|process|terminal|diff", file=sys.stderr)
        return 2

    label = ALIASES.get(sys.argv[1].lower(), sys.argv[1].lower())
    workspace_id = current_workspace_id()
    lock_name = re.sub(r"[^a-zA-Z0-9_-]+", "-", f"{workspace_id}-{label}")
    with open(f"/tmp/herdr-focus-tab-create-{lock_name}.lock", "a+") as lock_file:
        fcntl.flock(lock_file, fcntl.LOCK_EX)
        context = remote_context(workspace_id)
        mark_remote_workspace(workspace_id, context)
        tab = registered_tab(context, label) if context else None
        if tab is None:
            tab = tab_for_label(workspace_id, label)
        if tab is None:
            tab = herdr(
                "tab",
                "create",
                "--workspace",
                workspace_id,
                "--label",
                label,
                "--no-focus",
            )["result"]["tab"]
        register_tab(workspace_id, context, label, tab)
        schedule_default_command(tab, label, context)
        herdr("tab", "focus", tab["tab_id"])
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:
        print(f"herdr-focus-tab: {exc}", file=sys.stderr)
        raise SystemExit(1)
