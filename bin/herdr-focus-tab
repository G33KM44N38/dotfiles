#!/usr/bin/env python3
import fcntl
import json
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys
import time


ALIASES = {
    "run": "terminal",
    "terminal-run": "terminal",
    "long": "process",
    "long-process": "process",
    "misc": "diff",
    "notes": "diff",
    "scratch": "diff",
}

DEFAULT_COMMANDS = {
    "editor": "nvim .",
    "diff": "hunk diff --watch",
}

SHELL_NAMES = {"bash", "fish", "nu", "pwsh", "sh", "zsh"}
LAUNCH_TITLE_SOURCE = "boss:codex-launch-title"


def herdr(*args):
    result = subprocess.run(
        ["herdr", *args],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if result.returncode != 0:
        raise SystemExit(result.stderr.strip() or result.stdout.strip())
    output = result.stdout.strip()
    return json.loads(output) if output else {}


def current_workspace_id():
    return herdr("pane", "current")["result"]["pane"]["workspace_id"]


def tab_for_label(workspace_id, label):
    tabs = herdr("tab", "list", "--workspace", workspace_id)["result"]["tabs"]
    for tab in tabs:
        if (tab.get("label") or "").lower() == label:
            return tab
    return None


def pane_for_tab(tab_id, timeout=0):
    deadline = time.monotonic() + timeout
    while True:
        panes = herdr("pane", "list")["result"]["panes"]
        pane = next((pane for pane in panes if pane.get("tab_id") == tab_id), None)
        if pane is not None or time.monotonic() >= deadline:
            return pane
        time.sleep(0.05)


def pane_is_idle(pane_id):
    processes = herdr("pane", "process-info", "--pane", pane_id)["result"][
        "process_info"
    ].get("foreground_processes", [])
    return not any(
        (process.get("name") or "").lower() not in SHELL_NAMES
        for process in processes
    )


def pane_has_codex(pane_id):
    try:
        processes = herdr("pane", "process-info", "--pane", pane_id)["result"][
            "process_info"
        ].get("foreground_processes", [])
    except SystemExit:
        return False

    return any(
        (process.get("name") or "").lower() == "codex" for process in processes
    )


def unique_agent_name(pane, agents):
    project = os.path.basename(
        (pane.get("foreground_cwd") or pane.get("cwd") or "workspace").rstrip("/")
    ).lstrip(".")
    slug = re.sub(r"[^a-z0-9_-]+", "-", project.lower()).strip("-_")
    base = f"{slug or 'workspace'}-codex"[:32].rstrip("-_")
    names = {agent.get("name") for agent in agents if agent.get("name")}
    if base not in names:
        return base

    suffix = 2
    while True:
        ending = f"-{suffix}"
        candidate = f"{base[: 32 - len(ending)].rstrip('-_')}{ending}"
        if candidate not in names:
            return candidate
        suffix += 1


def publish_launch_title(pane_id, agent_name):
    herdr(
        "pane",
        "report-metadata",
        pane_id,
        "--source",
        LAUNCH_TITLE_SOURCE,
        "--agent",
        "codex",
        "--title",
        agent_name,
        "--seq",
        str(time.time_ns()),
    )


def launch_default_command(pane_id, label):
    command = DEFAULT_COMMANDS.get(label)
    if command is None or not pane_is_idle(pane_id):
        return

    herdr("pane", "run", pane_id, command)

    if label == "diff":
        # Hunk hides its file explorer below its full-width breakpoint. The
        # shortcut forces it open once the TUI has mounted.
        time.sleep(0.5)
        herdr("pane", "send-keys", pane_id, "s")


def close_idle_sibling_panes(tab_id, agent_pane_id, timeout=0):
    deadline = time.monotonic() + timeout
    while True:
        panes = herdr("pane", "list")["result"]["panes"]
        for pane in panes:
            pane_id = pane.get("pane_id")
            if (
                pane.get("tab_id") == tab_id
                and pane_id != agent_pane_id
                and pane_is_idle(pane_id)
            ):
                herdr("pane", "close", pane_id)
                return

        if time.monotonic() >= deadline:
            return
        time.sleep(0.05)


def launch_managed_agent(tab_id):
    # Multiple quick keypresses can start multiple detached workers. Serialize
    # provisioning so the tab's existing pane receives the command only once.
    with open("/tmp/herdr-focus-tab-agent.lock", "a+") as lock_file:
        fcntl.flock(lock_file, fcntl.LOCK_EX)
        ensure_managed_agent(tab_id)


def ensure_managed_agent(tab_id):
    agents = herdr("agent", "list")["result"]["agents"]
    agent = next(
        (
            agent
            for agent in agents
            if agent.get("tab_id") == tab_id and agent.get("agent") == "codex"
        ),
        None,
    )
    if agent is not None and pane_has_codex(agent["pane_id"]):
        close_idle_sibling_panes(tab_id, agent["pane_id"])
        herdr("agent", "focus", agent["pane_id"])
        return

    # Herdr materializes a newly-created tab's first pane asynchronously, and
    # sometimes only after the tab has been focused. The parent process focuses
    # the tab immediately after starting this worker, so wait for readiness
    # instead of treating a missing pane as a no-op.
    pane = pane_for_tab(tab_id, timeout=5)
    if pane is None:
        raise RuntimeError(f"agent tab {tab_id} did not create a pane")

    agent_name = unique_agent_name(pane, agents)
    command = " ".join(
        (
            shlex.quote(str(Path(__file__).with_name("herdr-run-codex-agent"))),
            "--interactive",
            "--close-tab-on-exit",
            "--dangerously-bypass-approvals-and-sandbox",
        )
    )
    herdr("pane", "run", pane["pane_id"], command)
    deadline = time.monotonic() + 5
    while time.monotonic() < deadline:
        agents = herdr("agent", "list")["result"]["agents"]
        agent = next(
            (
                agent
                for agent in agents
                if agent.get("tab_id") == tab_id
                and agent.get("agent") == "codex"
                and agent.get("pane_id") == pane["pane_id"]
                and pane_has_codex(agent["pane_id"])
            ),
            None,
        )
        if agent is not None:
            herdr("agent", "rename", agent["pane_id"], agent_name)
            publish_launch_title(agent["pane_id"], agent_name)
            close_idle_sibling_panes(tab_id, agent["pane_id"])
            herdr("agent", "focus", agent["pane_id"])
            return
        time.sleep(0.05)
    raise RuntimeError(f"Codex did not start in agent tab {tab_id}")


def schedule_default_command(tab, label):
    if label == "agent":
        subprocess.Popen(
            [
                sys.executable,
                __file__,
                "--managed-agent",
                tab["tab_id"],
            ],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        return

    if label not in DEFAULT_COMMANDS:
        return

    # A newly created tab gets its first pane asynchronously.
    pane = pane_for_tab(tab["tab_id"], timeout=1)
    if pane is None or not pane_is_idle(pane["pane_id"]):
        return

    # Both tab.focus and pane.run can terminate the keybinding's source
    # process. Launch in a detached worker so focusing and starting happen
    # independently during the same keypress.
    subprocess.Popen(
        [sys.executable, __file__, "--launch", pane["pane_id"], label],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def main():
    if len(sys.argv) == 3 and sys.argv[1] == "--managed-agent":
        launch_managed_agent(sys.argv[2])
        return 0

    if len(sys.argv) == 4 and sys.argv[1] == "--launch":
        time.sleep(0.1)
        launch_default_command(sys.argv[2], sys.argv[3])
        return 0

    if len(sys.argv) != 2:
        print("usage: herdr-focus-tab editor|agent|process|terminal|diff", file=sys.stderr)
        return 2

    label = ALIASES.get(sys.argv[1].lower(), sys.argv[1].lower())
    workspace_id = current_workspace_id()
    tab = tab_for_label(workspace_id, label)
    if tab is None:
        tab = herdr("tab", "create", "--workspace", workspace_id, "--label", label, "--no-focus")["result"]["tab"]
    schedule_default_command(tab, label)
    herdr("tab", "focus", tab["tab_id"])
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:
        print(f"herdr-focus-tab: {exc}", file=sys.stderr)
        raise SystemExit(1)
