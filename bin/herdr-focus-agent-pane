#!/usr/bin/env python3
import json
import os
import subprocess
import sys


def herdr(*args):
    result = subprocess.run(
        [os.environ.get("HERDR_BIN_PATH", "herdr"), *args],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or result.stdout.strip())
    return json.loads(result.stdout)


def ordered_agent_panes():
    layout = herdr("pane", "layout")["result"]["layout"]
    tab_id = layout["tab_id"]
    agent_ids = {
        agent["pane_id"]
        for agent in herdr("agent", "list")["result"]["agents"]
        if agent.get("tab_id") == tab_id and agent.get("pane_id")
    }
    panes = [pane for pane in layout["panes"] if pane["pane_id"] in agent_ids]
    return sorted(
        panes,
        key=lambda pane: (pane["rect"]["y"], pane["rect"]["x"]),
    )


def focus_index(index):
    panes = ordered_agent_panes()
    if index < 0 or index >= len(panes):
        return False
    herdr("agent", "focus", panes[index]["pane_id"])
    return True


def main():
    if len(sys.argv) != 2 or not sys.argv[1].isdigit():
        print("usage: herdr-focus-agent-pane 1..9", file=sys.stderr)
        return 2

    index = int(sys.argv[1]) - 1
    focus_index(index)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (KeyError, RuntimeError, json.JSONDecodeError) as exc:
        print(f"herdr-focus-agent-pane: {exc}", file=sys.stderr)
        raise SystemExit(1)
