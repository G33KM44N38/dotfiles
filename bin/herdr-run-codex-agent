#!/usr/bin/env bash
set -euo pipefail

readonly report_source="boss:codex-exec-wrapper"
readonly title_source="boss:codex-exec-title"
readonly completion_sound="$HOME/.dotfiles/bin/herdr-agent-completion-sound"
lifecycle_reporter_pid=

can_report() {
    [[ "${HERDR_ENV:-}" == "1" ]] &&
        [[ -n "${HERDR_PANE_ID:-}" ]] &&
        command -v herdr >/dev/null 2>&1
}

report_working() {
    herdr pane report-agent "$HERDR_PANE_ID" \
        --source "$report_source" \
        --agent codex \
        --state working \
        --message "Codex task running" >/dev/null 2>&1 || true
}

report_title() {
    local task_name=$1

    herdr pane report-metadata "$HERDR_PANE_ID" \
        --source "$title_source" \
        --agent codex \
        --applies-to-source "$report_source" \
        --title "$task_name" \
        --seq "$(python3 -c 'import time; print(time.time_ns())')" >/dev/null 2>&1 || true
}

derive_task_name() {
    python3 - "$PWD" "$@" <<'PY'
import os
import sys
import unicodedata

cwd, *arguments = sys.argv[1:]
value_options = {
    "-c", "--config", "--enable", "--disable", "-i", "--image",
    "-m", "--model", "--local-provider", "-p", "--profile", "-s",
    "--sandbox", "-C", "--cd", "--add-dir", "--output-schema",
    "--color", "-o", "--output-last-message",
}

prompt = None
index = 0
while index < len(arguments):
    argument = arguments[index]
    if argument == "--":
        prompt = arguments[index + 1] if index + 1 < len(arguments) else None
        break
    if argument in {"resume", "review"}:
        prompt = f"Codex {argument}"
        break
    if argument in value_options:
        index += 2
        continue
    if argument.startswith("-"):
        index += 1
        continue
    prompt = argument
    break

if not prompt or prompt == "-":
    project = os.path.basename(cwd.rstrip(os.sep)).lstrip(".") or "workspace"
    prompt = f"Codex task · {project}"

normalized = unicodedata.normalize("NFKC", prompt)
visible = "".join(
    " " if character.isspace() else character
    for character in normalized
    if character.isspace()
    or not unicodedata.category(character).startswith("C")
)
title = " ".join(visible.split()).lstrip("#>*-0123456789.) ")
if not title:
    title = "Codex task"
if len(title) > 72:
    clipped = title[:71].rstrip()
    if " " in clipped:
        clipped = clipped.rsplit(" ", 1)[0]
    title = clipped.rstrip(".,;:-") + "…"
print(title)
PY
}

report_working_when_codex_is_live() {
    local wrapper_pid=$1 process_json

    # A custom Herdr source does not receive full-lifecycle protection. If it
    # reports before Codex becomes the pane's foreground agent, Herdr can
    # correctly interpret that pre-launch snapshot as a process exit and clear
    # the report. Wait for Herdr's own process view to prove Codex is live so
    # the working authority and the process generation begin together.
    while kill -0 "$wrapper_pid" >/dev/null 2>&1; do
        process_json="$(herdr pane process-info --pane "$HERDR_PANE_ID" 2>/dev/null || true)"
        if printf '%s\n' "$process_json" | python3 -c '
import json, os, sys

try:
    processes = json.load(sys.stdin)["result"]["process_info"]["foreground_processes"]
except (KeyError, TypeError, ValueError):
    raise SystemExit(1)

raise SystemExit(
    0 if any(
        process.get("name") == "codex"
        or os.path.basename(str(process.get("argv0", ""))) == "codex"
        for process in processes
    ) else 1
)
' 2>/dev/null; then
            report_working
            return
        fi
        sleep 0.05
    done
}

start_lifecycle_reporter() {
    local wrapper_pid=$$

    # Keep Codex in the foreground so its terminal and signals remain unchanged.
    # The reporter is the only background child; its PID is captured immediately
    # for deterministic cleanup, while the wrapper PID bounds its polling loop.
    report_working_when_codex_is_live "$wrapper_pid" &
    lifecycle_reporter_pid=$!
}

stop_lifecycle_reporter() {
    if [[ -n "$lifecycle_reporter_pid" ]]; then
        kill "$lifecycle_reporter_pid" >/dev/null 2>&1 || true
        wait "$lifecycle_reporter_pid" 2>/dev/null || true
        lifecycle_reporter_pid=
    fi
}

release_agent() {
    stop_lifecycle_reporter
    if can_report; then
        "$completion_sound" >/dev/null 2>&1 || true
        herdr pane report-agent "$HERDR_PANE_ID" \
            --source "$report_source" \
            --agent codex \
            --state idle \
            --message "Codex task finished" >/dev/null 2>&1 || true
        herdr pane release-agent "$HERDR_PANE_ID" \
            --source "$report_source" \
            --agent codex >/dev/null 2>&1 || true
    fi

}

on_exit() {
    local exit_code=$?
    trap - EXIT
    release_agent "$exit_code"
    exit "$exit_code"
}

close_interactive_container() {
    local agents_json close_scope

    if ! can_report || [[ -z "${HERDR_TAB_ID:-}" ]]; then
        return
    fi

    if agents_json="$(herdr agent list 2>/dev/null)"; then
        close_scope="$(printf '%s\n' "$agents_json" | python3 -c '
import json, sys

tab_id, pane_id = sys.argv[1:]
try:
    agents = json.load(sys.stdin)["result"]["agents"]
except (json.JSONDecodeError, KeyError, TypeError):
    print("pane")
    raise SystemExit

has_sibling_agent = any(
    agent.get("tab_id") == tab_id and agent.get("pane_id") != pane_id
    for agent in agents
)
print("pane" if has_sibling_agent else "tab")
' "$HERDR_TAB_ID" "$HERDR_PANE_ID")"
    else
        close_scope=pane
    fi

    if [[ "$close_scope" == "tab" ]]; then
        herdr tab close "$HERDR_TAB_ID" >/dev/null 2>&1 || true
    else
        herdr pane close "$HERDR_PANE_ID" >/dev/null 2>&1 || true
    fi
}

# Bash 3.2 reads top-level scripts incrementally. Keep the long-running path in
# one parsed function so replacing this file cannot shift commands beneath a
# running `codex exec` process.
main() {
    if [[ "${1:-}" == "--interactive" ]]; then
        shift
        local close_tab_on_exit=false
        if [[ "${1:-}" == "--close-tab-on-exit" ]]; then
            close_tab_on_exit=true
            shift
        fi

        local codex_exit_code
        set +e
        codex "$@"
        codex_exit_code=$?
        set -e

        if [[ "$close_tab_on_exit" == true ]]; then
            close_interactive_container
        fi
        return "$codex_exit_code"
    fi

    local task_name=
    case "${1:-}" in
        --task-name)
            if (( $# < 2 )); then
                printf 'Usage: %s [--interactive [--close-tab-on-exit] [codex arguments...] | [--task-name <name>] [--] <codex exec arguments...>]\n' "${0##*/}" >&2
                return 2
            fi
            task_name=$2
            shift 2
            ;;
        --task-name=*)
            task_name=${1#--task-name=}
            shift
            ;;
    esac
    if [[ "${1:-}" == "--" ]]; then
        shift
    fi
    if (( $# == 0 )); then
        printf 'Usage: %s [--interactive [--close-tab-on-exit] [codex arguments...] | [--task-name <name>] [--] <codex exec arguments...>]\n' "${0##*/}" >&2
        return 2
    fi
    if [[ -z "$task_name" ]]; then
        task_name="$(derive_task_name "$@")"
    else
        task_name="$(derive_task_name -- "$task_name")"
    fi

    export HERDR_CODEX_LIFECYCLE_OWNER="wrapper"

    trap on_exit EXIT

    if can_report; then
        # Cover the launch edge immediately, then re-anchor the claim once
        # Herdr observes the actual Codex process generation.
        report_working
        report_title "$task_name"
        start_lifecycle_reporter
    fi

    local codex_exit_code
    set +e
    codex exec "$@"
    codex_exit_code=$?
    set -e

    stop_lifecycle_reporter

    trap - EXIT
    release_agent "$codex_exit_code"
    return "$codex_exit_code"
}

main "$@"
