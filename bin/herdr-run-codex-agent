#!/usr/bin/env bash
set -euo pipefail

readonly report_source="boss:codex-exec-wrapper"
readonly completion_sound=/Users/boss/.dotfiles/bin/herdr-agent-completion-sound
lifecycle_reporter_pid=

can_report() {
    [[ "${HERDR_ENV:-}" == "1" ]] &&
        [[ -n "${HERDR_PANE_ID:-}" ]] &&
        command -v herdr >/dev/null 2>&1
}

report_working() {
    herdr pane report-agent "$HERDR_PANE_ID" \
        --source "$report_source" \
        --agent codex \
        --state working \
        --message "Codex task running" >/dev/null 2>&1 || true
}

report_working_when_codex_is_live() {
    local wrapper_pid=$1 process_json

    # A custom Herdr source does not receive full-lifecycle protection. If it
    # reports before Codex becomes the pane's foreground agent, Herdr can
    # correctly interpret that pre-launch snapshot as a process exit and clear
    # the report. Wait for Herdr's own process view to prove Codex is live so
    # the working authority and the process generation begin together.
    while kill -0 "$wrapper_pid" >/dev/null 2>&1; do
        process_json="$(herdr pane process-info --pane "$HERDR_PANE_ID" 2>/dev/null || true)"
        if printf '%s\n' "$process_json" | python3 -c '
import json, os, sys

try:
    processes = json.load(sys.stdin)["result"]["process_info"]["foreground_processes"]
except (KeyError, TypeError, ValueError):
    raise SystemExit(1)

raise SystemExit(
    0 if any(
        process.get("name") == "codex"
        or os.path.basename(str(process.get("argv0", ""))) == "codex"
        for process in processes
    ) else 1
)
' 2>/dev/null; then
            report_working
            return
        fi
        sleep 0.05
    done
}

start_lifecycle_reporter() {
    local wrapper_pid=$$

    # Keep Codex in the foreground so its terminal and signals remain unchanged.
    # The reporter is the only background child; its PID is captured immediately
    # for deterministic cleanup, while the wrapper PID bounds its polling loop.
    report_working_when_codex_is_live "$wrapper_pid" &
    lifecycle_reporter_pid=$!
}

stop_lifecycle_reporter() {
    if [[ -n "$lifecycle_reporter_pid" ]]; then
        kill "$lifecycle_reporter_pid" >/dev/null 2>&1 || true
        wait "$lifecycle_reporter_pid" 2>/dev/null || true
        lifecycle_reporter_pid=
    fi
}

release_agent() {
    stop_lifecycle_reporter
    if can_report; then
        "$completion_sound" >/dev/null 2>&1 || true
        herdr pane report-agent "$HERDR_PANE_ID" \
            --source "$report_source" \
            --agent codex \
            --state idle \
            --message "Codex task finished" >/dev/null 2>&1 || true
        herdr pane release-agent "$HERDR_PANE_ID" \
            --source "$report_source" \
            --agent codex >/dev/null 2>&1 || true
    fi

}

on_exit() {
    local exit_code=$?
    trap - EXIT
    release_agent "$exit_code"
    exit "$exit_code"
}

close_interactive_container() {
    local tab_json pane_count

    if ! can_report || [[ -z "${HERDR_TAB_ID:-}" ]]; then
        return
    fi

    tab_json="$(herdr tab get "$HERDR_TAB_ID" 2>/dev/null || true)"
    pane_count="$(printf '%s\n' "$tab_json" | python3 -c '
import json, sys

try:
    print(json.load(sys.stdin)["result"]["tab"]["pane_count"])
except (KeyError, TypeError, ValueError):
    pass
' 2>/dev/null || true)"

    if [[ "$pane_count" == "1" ]]; then
        herdr tab close "$HERDR_TAB_ID" >/dev/null 2>&1 || true
    elif [[ -n "${HERDR_PANE_ID:-}" ]]; then
        herdr pane close "$HERDR_PANE_ID" >/dev/null 2>&1 || true
    fi
}

# Bash 3.2 reads top-level scripts incrementally. Keep the long-running path in
# one parsed function so replacing this file cannot shift commands beneath a
# running `codex exec` process.
main() {
    if (( $# == 0 )); then
        printf 'Usage: %s [--interactive [--close-tab-on-exit] | <codex exec arguments...>]\n' "${0##*/}" >&2
        return 2
    fi

    if [[ "$1" == "--interactive" ]]; then
        shift
        local close_tab_on_exit=false
        if [[ "${1:-}" == "--close-tab-on-exit" ]]; then
            close_tab_on_exit=true
            shift
        fi

        local codex_exit_code
        set +e
        codex "$@"
        codex_exit_code=$?
        set -e

        if [[ "$close_tab_on_exit" == true ]]; then
            close_interactive_container
        fi
        return "$codex_exit_code"
    fi

    export HERDR_CODEX_LIFECYCLE_OWNER="wrapper"

    trap on_exit EXIT

    if can_report; then
        # Cover the launch edge immediately, then re-anchor the claim once
        # Herdr observes the actual Codex process generation.
        report_working
        start_lifecycle_reporter
    fi

    local codex_exit_code
    set +e
    codex exec "$@"
    codex_exit_code=$?
    set -e

    stop_lifecycle_reporter

    trap - EXIT
    release_agent "$codex_exit_code"
    return "$codex_exit_code"
}

main "$@"
