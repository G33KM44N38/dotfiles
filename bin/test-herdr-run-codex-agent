#!/usr/bin/env bash
set -euo pipefail

readonly wrapper=/Users/boss/.dotfiles/bin/herdr-run-codex-agent
test_root="$(mktemp -d /tmp/herdr-wrapper-status.XXXXXX)"
trap 'rm -rf "$test_root"' EXIT
mkdir -p "$test_root/bin"

cat >"$test_root/bin/codex" <<'SH'
#!/bin/sh
printf 'codex-command:%s\n' "$*" >>"$HERDR_TEST_LOG"
if [ "${1:-}" != exec ]; then
    printf 'interactive-exit\n' >>"$HERDR_TEST_LOG"
    exit "${FAKE_CODEX_EXIT:-0}"
fi
shift
printf 'codex-args:%s\n' "$*" >>"$HERDR_TEST_LOG"
if [ -n "${FAKE_CODEX_LIVE_FILE:-}" ]; then
    sleep 0.1
    printf '%s\n' "$$" >"$FAKE_CODEX_LIVE_FILE"
    while [ ! -e "$FAKE_CODEX_EXIT_GATE" ]; do
        sleep 0.02
    done
    printf 'codex-exit\n' >>"$HERDR_TEST_LOG"
fi
output_file=
while [ "$#" -gt 0 ]; do
    case "$1" in
        -o|--output-last-message) output_file=$2; shift 2 ;;
        *) shift ;;
    esac
done
[ -z "$output_file" ] || printf 'terminal-visible success\n' >"$output_file"
printf 'terminal-visible child exit %s\n' "${FAKE_CODEX_EXIT:-0}"
if [ -n "${SELF_REWRITE_TARGET:-}" ]; then
    printf '#!/bin/sh\nexit 99\n' >"$SELF_REWRITE_TARGET"
fi
exit "${FAKE_CODEX_EXIT:-0}"
SH

cat >"$test_root/bin/herdr" <<'SH'
#!/bin/sh
printf '%s\n' "$*" >>"$HERDR_TEST_LOG"
case "$*" in
    'pane process-info --pane proof:lifetime')
        if [ -s "$FAKE_CODEX_LIVE_FILE" ]; then
            pid=$(cat "$FAKE_CODEX_LIVE_FILE")
            printf '{"result":{"process_info":{"foreground_processes":[{"pid":%s,"name":"codex","argv0":"codex"}]}}}\n' "$pid"
        else
            printf 'unknown\n' >"$FAKE_HERDR_STATE"
            printf '{"result":{"process_info":{"foreground_processes":[]}}}\n'
        fi
        ;;
    'pane process-info --pane '*)
        printf '{"result":{"process_info":{"foreground_processes":[{"pid":1,"name":"codex","argv0":"codex"}]}}}\n'
        ;;
    'pane get proof:lifetime')
        state=$(cat "$FAKE_HERDR_STATE")
        [ "$state" != unknown ] || state=done
        printf '{"result":{"pane":{"pane_id":"proof:lifetime","agent_status":"%s"}}}\n' "$state"
        ;;
    'workspace get proof')
        state=$(cat "$FAKE_HERDR_STATE")
        # The sibling pane is seen/idle. A working wrapper pane must therefore
        # make the current workspace working; after release it returns idle.
        [ "$state" = working ] || state=idle
        printf '{"result":{"workspace":{"workspace_id":"proof","agent_status":"%s"}}}\n' "$state"
        ;;
    *'proof:lifetime'*'--state working'*) printf 'working\n' >"$FAKE_HERDR_STATE" ;;
    *'proof:lifetime'*'--state idle'*) printf 'idle\n' >"$FAKE_HERDR_STATE" ;;
    *'release-agent'*'proof:lifetime'*) printf 'unknown\n' >"$FAKE_HERDR_STATE" ;;
    'agent list')
        case "${FAKE_AGENT_LIST_MODE:-last}" in
            sibling)
                printf '%s\n' '{"result":{"agents":[{"pane_id":"proof:p1","tab_id":"proof:t1","agent":"codex"},{"pane_id":"proof:p2","tab_id":"proof:t1","agent":"codex"},{"pane_id":"other:p1","tab_id":"other:t1","agent":"codex"}]}}'
                ;;
            last) printf '%s\n' '{"result":{"agents":[]}}' ;;
            malformed) printf '%s\n' 'not-json' ;;
            failure) exit 72 ;;
        esac
        ;;
    *'--state idle'*|*'release-agent'*) [ "${FAIL_CLEANUP:-0}" -eq 0 ] || exit 71 ;;
esac
exit 0
SH

chmod +x "$test_root/bin/"*

run_case() {
    local name=$1 child_exit=$2 cleanup_fails=$3 rewrite=$4
    local case_wrapper="$test_root/wrapper-$name"
    local herdr_log="$test_root/herdr-$name.log"
    cp -p "$wrapper" "$case_wrapper"
    : >"$herdr_log"

    local rewrite_target=
    [[ "$rewrite" == false ]] || rewrite_target=$case_wrapper
    set +e
    PATH="$test_root/bin:/usr/bin:/bin" \
        HERDR_ENV=1 \
        HERDR_PANE_ID="proof:$name" \
        HERDR_WORKSPACE_ID=proof \
        HERDR_TAB_ID=proof \
        HERDR_TEST_LOG="$herdr_log" \
        FAKE_CODEX_EXIT="$child_exit" \
        FAIL_CLEANUP="$cleanup_fails" \
        SELF_REWRITE_TARGET="$rewrite_target" \
        "$case_wrapper" "proof-$name" >"$test_root/stdout-$name.log" 2>"$test_root/stderr-$name.log"
    local actual_exit=$?
    set -e

    [[ "$actual_exit" -eq "$child_exit" ]]
    grep -Fxq -- "codex-command:exec proof-$name" "$herdr_log"
    grep -q -- '--state working' "$herdr_log"
    grep -q -- '--state idle' "$herdr_log"
    grep -q -- 'release-agent' "$herdr_log"
    grep -q -- 'api snapshot' "$herdr_log"
    grep -Fq -- "pane report-metadata proof:$name --source boss:codex-exec-title --agent codex --applies-to-source boss:codex-exec-wrapper --title proof-$name" "$herdr_log"
    ! grep -Fq -- 'command not found' "$test_root/stderr-$name.log"
    if [[ "$rewrite" == true ]]; then
        grep -Fxq '#!/bin/sh' "$case_wrapper"
        grep -Fxq 'exit 99' "$case_wrapper"
    fi
}

run_case success 0 0 false
run_case success_cleanup_failure 0 1 false
run_case failure_cleanup_failure 7 1 false
run_case success_self_rewrite 0 1 true

run_explicit_title_case() {
    local herdr_log="$test_root/herdr-explicit-title.log"
    : >"$herdr_log"

    PATH="$test_root/bin:/usr/bin:/bin" \
        HERDR_ENV=1 \
        HERDR_PANE_ID=proof:explicit \
        HERDR_WORKSPACE_ID=proof \
        HERDR_TAB_ID=proof \
        HERDR_TEST_LOG="$herdr_log" \
        "$wrapper" --task-name "Release worker" -- "actual task prompt"

    grep -Fq -- 'pane report-metadata proof:explicit --source boss:codex-exec-title --agent codex --applies-to-source boss:codex-exec-wrapper --title Release worker' "$herdr_log"
    grep -Fxq 'codex-command:exec actual task prompt' "$herdr_log"
    grep -Fxq 'codex-args:actual task prompt' "$herdr_log"
    [[ "$(grep -n -m1 'report-metadata' "$herdr_log" | cut -d: -f1)" -lt "$(grep -n -m1 'codex-args:' "$herdr_log" | cut -d: -f1)" ]]
}

run_explicit_title_case

run_interactive_close_case() {
    local name=$1 list_mode=$2 expected_close=$3
    local herdr_log="$test_root/herdr-interactive-$name.log"
    : >"$herdr_log"

    PATH="$test_root/bin:/usr/bin:/bin" \
        HERDR_ENV=1 \
        HERDR_PANE_ID=proof:p1 \
        HERDR_WORKSPACE_ID=proof \
        HERDR_TAB_ID=proof:t1 \
        HERDR_TEST_LOG="$herdr_log" \
        FAKE_AGENT_LIST_MODE="$list_mode" \
        "$wrapper" --interactive --close-tab-on-exit \
        --dangerously-bypass-approvals-and-sandbox

    grep -Fxq 'codex-command:--dangerously-bypass-approvals-and-sandbox' "$herdr_log"
    grep -Fxq 'interactive-exit' "$herdr_log"
    grep -Fxq 'agent list' "$herdr_log"
    grep -Fxq "$expected_close" "$herdr_log"
    ! grep -q -- 'report-agent\|report-metadata\|release-agent' "$herdr_log"
}

run_interactive_close_case sibling sibling 'pane close proof:p1'
run_interactive_close_case last last 'tab close proof:t1'
run_interactive_close_case malformed malformed 'pane close proof:p1'
run_interactive_close_case list_failure failure 'pane close proof:p1'

run_lifetime_case() {
    local herdr_log="$test_root/herdr-lifetime.log"
    local live_file="$test_root/codex-live"
    local exit_gate="$test_root/codex-exit-gate"
    local state_file="$test_root/herdr-state"
    : >"$herdr_log"
    printf 'unknown\n' >"$state_file"
    rm -f "$live_file" "$exit_gate"

    fake_herdr() {
        HERDR_TEST_LOG="$herdr_log" \
            FAKE_HERDR_STATE="$state_file" \
            FAKE_CODEX_LIVE_FILE="$live_file" \
            "$test_root/bin/herdr" "$@"
    }

    PATH="$test_root/bin:/usr/bin:/bin" \
        HERDR_ENV=1 \
        HERDR_PANE_ID=proof:lifetime \
        HERDR_WORKSPACE_ID=proof \
        HERDR_TAB_ID=proof \
        HERDR_TEST_LOG="$herdr_log" \
        FAKE_HERDR_STATE="$state_file" \
        FAKE_CODEX_LIVE_FILE="$live_file" \
        FAKE_CODEX_EXIT_GATE="$exit_gate" \
        "$wrapper" proof-lifetime &
    local wrapper_pid=$!

    local attempts=0
    while [[ ! -s "$live_file" ]] ||
        [[ "$(grep -c -- '--state working' "$herdr_log" || true)" -lt 2 ]] ||
        [[ "$(cat "$state_file")" != working ]]; do
        kill -0 "$wrapper_pid" || return 1
        attempts=$((attempts + 1))
        [[ "$attempts" -lt 200 ]] || return 1
        sleep 0.02
    done

    local codex_pid
    codex_pid="$(cat "$live_file")"
    [[ "$codex_pid" != "$wrapper_pid" ]]

    local sample
    for sample in 1 2 3 4 5; do
        kill -0 "$wrapper_pid" || return 1
        kill -0 "$codex_pid" || return 1
        [[ "$(fake_herdr pane get proof:lifetime | python3 -c 'import json,sys; print(json.load(sys.stdin)["result"]["pane"]["agent_status"])')" == working ]] || return 1
        [[ "$(fake_herdr workspace get proof | python3 -c 'import json,sys; print(json.load(sys.stdin)["result"]["workspace"]["agent_status"])')" == working ]] || return 1
        ! grep -q 'release-agent' "$herdr_log" || return 1
        sleep 0.02
    done

    touch "$exit_gate"
    wait "$wrapper_pid"

    [[ "$(fake_herdr pane get proof:lifetime | python3 -c 'import json,sys; print(json.load(sys.stdin)["result"]["pane"]["agent_status"])')" == done ]] || return 1
    [[ "$(fake_herdr workspace get proof | python3 -c 'import json,sys; print(json.load(sys.stdin)["result"]["workspace"]["agent_status"])')" == idle ]] || return 1
    [[ "$(grep -n -m1 'codex-exit' "$herdr_log" | cut -d: -f1)" -lt "$(grep -n -m1 'release-agent' "$herdr_log" | cut -d: -f1)" ]] || return 1
}

run_lifetime_case

printf 'herdr-wrapper-status-regression-ok\n'
