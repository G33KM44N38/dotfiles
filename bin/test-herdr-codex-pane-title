#!/usr/bin/env python3
"""Focused regression tests for stable interactive Codex pane titles."""

from __future__ import annotations

import json
import os
from pathlib import Path
import stat
import subprocess
import tempfile
import time


HOOK = Path("/Users/boss/.dotfiles/bin/herdr-codex-lifecycle-hook")


def write_executable(path: Path, contents: str) -> None:
    path.write_text(contents)
    path.chmod(path.stat().st_mode | stat.S_IXUSR)


def main() -> int:
    with tempfile.TemporaryDirectory(prefix="herdr-codex-title-") as root_value:
        root = Path(root_value)
        bin_dir = root / "bin"
        state_dir = root / "state"
        report_log = root / "reports.jsonl"
        bin_dir.mkdir()

        write_executable(
            bin_dir / "herdr",
            """#!/usr/bin/env python3
import json, os, sys
with open(os.environ["HERDR_TEST_REPORT_LOG"], "a", encoding="utf-8") as log:
    print(json.dumps(sys.argv[1:]), file=log)
""",
        )
        write_executable(bin_dir / "completion-sound", "#!/bin/sh\nexit 0\n")
        write_executable(
            bin_dir / "codex",
            """#!/usr/bin/env python3
import json, os, pathlib, sys, time
with open(os.environ["HERDR_TEST_CODEX_LOG"], "a", encoding="utf-8") as log:
    print(json.dumps(sys.argv[1:]), file=log)
time.sleep(float(os.environ.get("HERDR_TEST_CODEX_DELAY", "0")))
path = pathlib.Path(sys.argv[sys.argv.index("--output-last-message") + 1])
path.write_text("Corriger les titres Herdr\\n", encoding="utf-8")
""",
        )

        codex_log = root / "codex.jsonl"
        env = {
            **os.environ,
            "PATH": f"{bin_dir}:/usr/bin:/bin",
            "HERDR_ENV": "1",
            "HERDR_PANE_ID": "proof:target-pane",
            "HERDR_CODEX_LIFECYCLE_STATE_DIR": str(state_dir),
            "HERDR_CODEX_TITLE_STATE_DIR": str(root / "title-state"),
            "HERDR_CODEX_COMPLETION_SOUND": str(bin_dir / "completion-sound"),
            "HERDR_CODEX_TITLE_GENERATION": "0",
            "HERDR_TEST_CODEX_LOG": str(codex_log),
            "HERDR_TEST_REPORT_LOG": str(report_log),
        }
        env.pop("HERDR_CODEX_LIFECYCLE_OWNER", None)

        def invoke(action: str, session_id: str, **fields: object) -> list[list[str]]:
            before = len(report_log.read_text().splitlines()) if report_log.exists() else 0
            payload = {
                "hook_event_name": {
                    "start": "SessionStart",
                    "working": "UserPromptSubmit",
                }.get(action, action),
                "session_id": session_id,
                **fields,
            }
            subprocess.run(
                [str(HOOK), action],
                input=json.dumps(payload),
                text=True,
                env=env,
                check=True,
            )
            lines = report_log.read_text().splitlines()[before:]
            return [json.loads(line) for line in lines]

        def title_from(commands: list[list[str]]) -> str | None:
            for command in commands:
                if command[:2] == ["pane", "report-metadata"]:
                    assert command[2] == env["HERDR_PANE_ID"]
                    assert "current" not in command
                    assert "rename" not in command
                    assert "--display-agent" not in command
                    assert command[command.index("--agent") + 1] == "codex"
                    return command[command.index("--title") + 1]
            return None

        session_one = "019fc240-becc-7261-8e2c-6db899ca2a9d"
        session_two = "019fc241-cafe-7261-8e2c-6db899ca2a9d"
        one_suffix = " · codex-019fc240-b"
        two_suffix = " · codex-019fc241-c"

        assert title_from(invoke("start", session_one, source="startup")) == (
            "Codex session" + one_suffix
        )
        first_title = title_from(
            invoke(
                "working",
                session_one,
                prompt="##  Implement\n\tan elegant automatic pane title synchronizer safely",
            )
        )
        assert first_title == (
            "Implement an elegant automatic pane title…" + one_suffix
        )

        # The durable subject is the first meaningful prompt, never the latest
        # message. Compaction uses the same id and cannot reset it either.
        assert title_from(
            invoke("working", session_one, prompt="Completely different follow-up")
        ) == first_title
        assert title_from(
            invoke("start", session_one, source="compact")
        ) == first_title

        # /new and /clear arrive with a fresh id and reset immediately. Slash
        # commands and empty/control-only inputs are not meaningful subjects.
        assert title_from(invoke("start", session_two, source="clear")) == (
            "Codex session" + two_suffix
        )
        assert title_from(invoke("working", session_two, prompt="/clear")) == (
            "Codex session" + two_suffix
        )
        assert title_from(invoke("working", session_two, prompt="\x00\n***")) == (
            "Codex session" + two_suffix
        )
        assert title_from(
            invoke("working", session_two, prompt="Fix the sidebar")
        ) == "Fix the sidebar" + two_suffix

        # Similar subjects remain distinguishable because their ids differ.
        session_three = "019fc242-dead-7261-8e2c-6db899ca2a9d"
        assert title_from(invoke("start", session_three, source="startup")) == (
            "Codex session · codex-019fc242-d"
        )
        third_title = title_from(
            invoke("working", session_three, prompt="Fix the sidebar")
        )
        assert third_title == "Fix the sidebar · codex-019fc242-d"
        assert third_title != "Fix the sidebar" + two_suffix

        # Resuming the same discussion in another pane restores the exact
        # canonical subject instead of publishing the generic fallback.
        env["HERDR_PANE_ID"] = "proof:resumed-pane"
        assert title_from(
            invoke("start", session_three, source="resume")
        ) == third_title

        # Sessions created before the durable title index was introduced can
        # recover their original task from the transcript supplied by Codex.
        legacy_resume = "019fc242-old1-7261-8e2c-6db899ca2a9d"
        legacy_transcript = root / "legacy-resume.jsonl"
        legacy_transcript.write_text(
            json.dumps(
                {
                    "type": "event_msg",
                    "payload": {
                        "type": "user_message",
                        "message": "Diagnostiquer le cache de production",
                    },
                }
            )
            + "\n",
            encoding="utf-8",
        )
        assert title_from(
            invoke(
                "start",
                legacy_resume,
                source="resume",
                transcript_path=str(legacy_transcript),
            )
        ) == "Diagnostiquer le cache de production · codex-019fc242-o"

        # If Codex cannot supply an old transcript, keep the existing launch
        # metadata rather than replacing it with "Codex session".
        missing_resume = "019fc242-miss-7261-8e2c-6db899ca2a9d"
        assert title_from(
            invoke("start", missing_resume, source="resume")
        ) is None

        env["HERDR_PANE_ID"] = "proof:target-pane"

        # The first prompt launches Luna outside the hook's blocking path. The
        # deterministic title appears immediately and the generated title then
        # replaces it for the same active discussion.
        generated_env = {**env, "HERDR_CODEX_TITLE_GENERATION": "1"}
        generated_session = "019fc243-title-7261-8e2c-6db899ca2a9d"
        before = len(report_log.read_text().splitlines())
        subprocess.run(
            [str(HOOK), "start"],
            input=json.dumps({"session_id": generated_session}),
            text=True,
            env=generated_env,
            check=True,
        )
        subprocess.run(
            [str(HOOK), "working"],
            input=json.dumps(
                {
                    "session_id": generated_session,
                    "prompt": "Le titre initial est beaucoup trop générique",
                }
            ),
            text=True,
            env=generated_env,
            check=True,
        )
        immediate_commands = [
            json.loads(line) for line in report_log.read_text().splitlines()[before:]
        ]
        assert title_from(immediate_commands) == (
            "Codex session · codex-019fc243-t"
        )

        deadline = time.monotonic() + 3
        generated_title = None
        while time.monotonic() < deadline:
            commands = [
                json.loads(line)
                for line in report_log.read_text().splitlines()[before:]
            ]
            titles = [
                command[command.index("--title") + 1]
                for command in commands
                if command[:2] == ["pane", "report-metadata"]
            ]
            generated_title = next(
                (title for title in titles if title.startswith("Corriger les titres Herdr")),
                None,
            )
            if generated_title:
                break
            time.sleep(0.02)
        assert generated_title == "Corriger les titres Herdr · codex-019fc243-t"

        env["HERDR_PANE_ID"] = "proof:generated-resume-pane"
        assert title_from(
            invoke("start", generated_session, source="resume")
        ) == generated_title
        env["HERDR_PANE_ID"] = "proof:target-pane"

        codex_args = json.loads(codex_log.read_text().splitlines()[0])
        assert codex_args[codex_args.index("--model") + 1] == "gpt-5.6-luna"
        assert "--ignore-user-config" in codex_args
        assert "--ignore-rules" in codex_args
        assert "--ephemeral" in codex_args

        # A slow result from an old discussion must not rename a pane after a
        # new session has taken ownership of it.
        stale_env = {**generated_env, "HERDR_TEST_CODEX_DELAY": "0.2"}
        stale_session = "019fc244-stale-7261-8e2c-6db899ca2a9d"
        current_session = "019fc245-fresh-7261-8e2c-6db899ca2a9d"
        subprocess.run(
            [str(HOOK), "start"],
            input=json.dumps({"session_id": stale_session}),
            text=True,
            env=stale_env,
            check=True,
        )
        subprocess.run(
            [str(HOOK), "working"],
            input=json.dumps({"session_id": stale_session, "prompt": "Ancien travail"}),
            text=True,
            env=stale_env,
            check=True,
        )
        subprocess.run(
            [str(HOOK), "start"],
            input=json.dumps({"session_id": current_session}),
            text=True,
            env=stale_env,
            check=True,
        )
        after_new_session = len(report_log.read_text().splitlines())
        time.sleep(0.35)
        later_commands = [
            json.loads(line)
            for line in report_log.read_text().splitlines()[after_new_session:]
        ]
        assert not any(
            command[:2] == ["pane", "report-metadata"]
            and command[command.index("--title") + 1].endswith("codex-019fc244-s")
            for command in later_commands
        )

        # Migration guard: a prompt without prior SessionStart belongs to an
        # already-running discussion. It must neither infer a subject nor
        # overwrite display metadata, including after compact with the same id.
        migrated_session = "019fc100-old0-7261-8e2c-6db899ca2a9d"
        assert title_from(
            invoke(
                "working",
                migrated_session,
                prompt="Latest prompt must never become the old session title",
            )
        ) is None
        assert title_from(
            invoke("start", migrated_session, source="compact")
        ) is None
        assert title_from(
            invoke("working", migrated_session, prompt="Nor may a later prompt")
        ) is None

        # Programmatic sessions remain fully owned by herdr-run-codex-agent.
        wrapper_env = {**env, "HERDR_CODEX_LIFECYCLE_OWNER": "wrapper"}
        before = report_log.read_text()
        subprocess.run(
            [str(HOOK), "start"],
            input=json.dumps({"session_id": "programmatic"}),
            text=True,
            env=wrapper_env,
            check=True,
        )
        assert report_log.read_text() == before

        # Without an explicit pane id the hook must never fall back to focus.
        no_pane_env = {**env}
        no_pane_env.pop("HERDR_PANE_ID")
        subprocess.run(
            [str(HOOK), "working"],
            input=json.dumps({"session_id": "missing-pane", "prompt": "Do work"}),
            text=True,
            env=no_pane_env,
            check=True,
        )
        assert report_log.read_text() == before

    print("herdr-codex-pane-title-regression-ok")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
