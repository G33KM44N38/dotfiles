#!/usr/bin/env python3
import argparse
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path


CHILD_SEARCH_ROOTS = (
    "Library/Mobile Documents/iCloud~md~obsidian/Documents",
    "backup",
    "code",
    "coding",
    "coding/work",
    "coding/perso",
    "goinfre",
    "learning",
)

EXACT_PATHS = (".dotfiles", "backup", "code", "coding")


def fail(message: str, code: int = 1) -> None:
    print(f"herdr-navigate: {message}", file=sys.stderr)
    raise SystemExit(code)


def run(args, *, check=True):
    result = subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    if check and result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip()
        fail(f"{' '.join(args)} failed: {detail}")
    return result


def herdr_json(*args: str):
    result = run(["herdr", *args])
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        fail(f"invalid herdr JSON from {' '.join(args)}: {exc}")


def normalize(path: str) -> Path:
    resolved = Path(path).expanduser()
    if not resolved.is_absolute():
        resolved = Path.cwd() / resolved
    return resolved.resolve()


def workspace_git_paths(workspace: dict) -> tuple[set[str], set[str], bool]:
    checkout_paths = set()
    repo_paths = set()
    worktree = workspace.get("worktree") or {}
    if worktree.get("checkout_path"):
        checkout_paths.add(str(normalize(worktree["checkout_path"])))
    for key in ("repo_root", "repo_key"):
        if worktree.get(key):
            repo_paths.add(str(normalize(worktree[key])))
    return checkout_paths, repo_paths, bool(worktree.get("is_linked_worktree"))


def pane_workspace_paths() -> dict[str, set[str]]:
    paths: dict[str, set[str]] = {}
    try:
        data = herdr_json("pane", "list")
    except SystemExit:
        return paths
    for pane in data.get("result", {}).get("panes", []):
        workspace_id = pane.get("workspace_id") or ""
        if not workspace_id:
            continue
        for key in ("foreground_cwd", "cwd"):
            value = pane.get(key)
            if value:
                paths.setdefault(workspace_id, set()).add(str(normalize(value)))
    return paths


def label_for(path: Path) -> str:
    return path.name.replace(".", "_")


def matching_workspace(path: Path, workspaces: list[dict], pane_paths: dict[str, set[str]]) -> dict | None:
    target = str(path)
    matches: list[tuple[int, dict]] = []
    for workspace in workspaces:
        workspace_id = workspace.get("workspace_id", "")
        checkout_paths, repo_paths, linked_worktree = workspace_git_paths(workspace)
        if target in checkout_paths and not linked_worktree:
            matches.append((0, workspace))
        elif target in checkout_paths:
            matches.append((1, workspace))
        elif target in pane_paths.get(workspace_id, set()):
            matches.append((2, workspace))
        elif target in repo_paths and not linked_worktree:
            matches.append((3, workspace))

    return sorted(matches, key=lambda item: item[0])[0][1] if matches else None


def selectable_directories() -> list[Path]:
    directories: set[Path] = set()
    for relative_root in CHILD_SEARCH_ROOTS:
        root = normalize(str(Path.home() / relative_root))
        if not root.is_dir():
            continue
        directories.update(path.resolve() for path in root.iterdir() if path.is_dir())
    for relative_path in EXACT_PATHS:
        path = normalize(str(Path.home() / relative_path))
        if path.is_dir():
            directories.add(path)
    return sorted(directories, key=lambda path: str(path).casefold())


def select_path() -> Path | None:
    if not shutil.which("fzf"):
        fail("fzf not found in PATH")

    directories = selectable_directories()
    if not directories:
        fail("no valid search directories found")

    workspaces = herdr_json("workspace", "list").get("result", {}).get("workspaces", [])
    pane_paths = pane_workspace_paths()
    name_counts: dict[str, int] = {}
    for path in directories:
        name_counts[label_for(path)] = name_counts.get(label_for(path), 0) + 1

    rows = []
    for path in directories:
        label = label_for(path) if name_counts[label_for(path)] == 1 else str(path)
        if matching_workspace(path, workspaces, pane_paths):
            label = f"[HERDR] {label}"
        rows.append(f"{label}\t{path}")

    result = subprocess.run(
        ["fzf", "--ansi", "--delimiter=\\t", "--with-nth=1", "--prompt=workspace > "],
        input="\n".join(rows) + "\n",
        stdout=subprocess.PIPE,
        text=True,
    )
    if result.returncode == 130 or not result.stdout.strip():
        return None
    if result.returncode != 0:
        fail(f"fzf failed with exit code {result.returncode}")
    return normalize(result.stdout.rstrip("\n").split("\t", 1)[1])


def focus_or_create(path: Path, *, dry_run: bool) -> None:
    target = str(path)
    data = herdr_json("workspace", "list")
    workspaces = data.get("result", {}).get("workspaces", [])
    pane_paths = pane_workspace_paths()
    workspace = matching_workspace(path, workspaces, pane_paths)

    if workspace:
        workspace_id = workspace.get("workspace_id", "")
        if dry_run:
            print(f"focus\t{workspace_id}\t{target}\t{workspace.get('label', '')}")
            return
        run(["herdr", "workspace", "focus", workspace_id])
        return

    if dry_run:
        print(f"create\t\t{target}\t{label_for(path)}")
        return
    run(["herdr", "workspace", "create", "--cwd", target, "--label", label_for(path), "--focus"])


def main() -> None:
    parser = argparse.ArgumentParser(description="Select a directory, then focus or create its Herdr workspace.")
    parser.add_argument("path", nargs="?")
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()

    if not shutil.which("herdr"):
        fail("herdr not found in PATH")

    path = normalize(args.path) if args.path else select_path()
    if path is None:
        return
    if not path.exists():
        fail(f"path does not exist: {path}")
    if not path.is_dir():
        fail(f"path is not a directory: {path}")
    focus_or_create(path, dry_run=args.dry_run)


if __name__ == "__main__":
    main()
