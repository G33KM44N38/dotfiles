#!/usr/bin/env bash
set -euo pipefail

root="$HOME/.dotfiles"
source_dir="$root/dev/herdr_worktree_picker_go"
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/herdr-worktree-picker"
binary="$cache_dir/herdr-worktree-picker"

mkdir -p "$cache_dir"
rebuild=false
if [ ! -x "$binary" ]; then
	rebuild=true
else
	for source_file in "$source_dir"/*.go "$root/go.mod" "$root/go.sum"; do
		case "$source_file" in *_test.go) continue ;; esac
		if [ "$source_file" -nt "$binary" ]; then
			rebuild=true
			break
		fi
	done
fi
if [ "$rebuild" = true ]; then
	tmp_binary="$binary.$$"
	(cd "$root" && go build -o "$tmp_binary" ./dev/herdr_worktree_picker_go)
	mv "$tmp_binary" "$binary"
fi

exec "$binary" "$@"
